    # ── Build API handler ──
    class DashHandler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            parsed = urllib.parse.urlparse(self.path)
            if parsed.path == "/" or parsed.path == "/index.html":
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                self.wfile.write(DASHBOARD_HTML.encode("utf-8"))

            elif parsed.path == "/api/subscriptions":
                subs = load_subscriptions()
                self._json_response(subs)

            elif parsed.path == "/api/state":
                state = load_state()
                self._json_response(state)

            elif parsed.path == "/api/log":
                entries = []
                if os.path.exists(LOG_FILE):
                    try:
                        with open(LOG_FILE) as f:
                            for line in f:
                                line = line.strip()
                                if not line:
                                    continue
                                entry = {"raw": line}
                                m = re.match(
                                    r"\[(.*?)\] (CODE|EVENT) sender=(.*?) subject=(.*?) (?:code|event)=(.*)",
                                    line
                                )
                                if m:
                                    entry["ts"] = m.group(1)
                                    entry["type"] = m.group(2)
                                    entry["sender"] = m.group(3)
                                    entry["subject"] = m.group(4)
                                    entry["value"] = m.group(5)
                                    if m.group(2) == "CODE":
                                        entry["code"] = m.group(5)
                                    else:
                                        entry["event"] = m.group(5)
                                entries.append(entry)
                    except Exception:
                        pass
                self._json_response(entries)

            else:
                self.send_response(404)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"error":"not found"}')

        def _json_response(self, data):
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            try:
                raw = json_mod.dumps(data, ensure_ascii=False, default=str)
                self.wfile.write(raw.encode("utf-8"))
            except Exception:
                self.wfile.write(b"[]")

        def log_message(self, format, *args):
            # Quiet — don't clutter terminal
            pass

    # ── Find a free port ──
    port = 8899
    for attempt in range(10):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.bind(("127.0.0.1", port))
            s.close()
            break
        except OSError:
            port += 1
    else:
        print(c("  ✗  Could not find a free port.", Style.RED))
        return

    # ── Start server in background thread ──
    server = socketserver.TCPServer(("127.0.0.1", port), DashHandler)
    server_thread = threading.Thread(target=server.serve_forever, daemon=True)
    server_thread.start()

    # ── Open browser ──
    url = f"http://127.0.0.1:{port}"
    print()
    print(c("  ╔══════════════════════════════════════════╗", Style.CYAN, Style.BOLD))
    print(c("  ║   📊  verify-code Dashboard             ║", Style.CYAN, Style.BOLD))
    print(c(f"  ║   {url:<34}  ║", Style.CYAN))
    print(c("  ╚══════════════════════════════════════════╝", Style.CYAN, Style.BOLD))
    print()
    print(c(f"  🌐  Dashboard: {url}", Style.GREEN, Style.BOLD))
    print(c("  🚪  Press Ctrl+C to stop the server.", Style.DIM))
    print()

    webbrowser.open(url)

    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print()
        print(c("  🛑  Dashboard server stopped.", Style.YELLOW))
        server.shutdown()


def daemon_run(args):
    """Background daemon mode: watch inbox, auto-copy codes, extract events."""
    creds = load_creds()
    window = datetime.timedelta(minutes=args.minutes)
    state = load_state()
    last_uid = int(state.get("last_uid", 0))
    seen_codes = set(state.get("seen_codes", []))
    seen_events = set(state.get("seen_events", []))
    seen_subscriptions = set(state.get("seen_subscriptions", []))
    interval = args.interval

    have_calendar = bool(get_calendar_service())

    # Resolve secure timeout: CLI override > creds config > off
    if args.secure_timeout > 0:
        secure_timeout = args.secure_timeout
    elif args.secure:
        secure_timeout = creds.get("secure_timeout", 30)
    elif creds.get("secure"):
        secure_timeout = creds.get("secure_timeout", 30)
    else:
        secure_timeout = 0

    if not IS_WINDOWS and not _which("wl-copy"):
        notify("verify-code", "wl-copy not found — install wl-clipboard for auto-copy.")
        print(c("WARNING: wl-copy missing; codes will be logged but not copied.", Style.YELLOW), file=sys.stderr)

    print(c(f"  🔐  verify-code daemon v{__version__} started", Style.CYAN, Style.BOLD))
    print(f"     Window: {args.minutes}m  |  Interval: {interval}s"
          f"  |  Known-senders: {'yes' if args.known_senders else 'no'}"
          f"  |  Calendar: {'yes' if have_calendar else 'no'}"
          f"  |  Subs: {'yes' if args.subscriptions else 'no'}"
          f"  |  Secure: {'yes' if secure_timeout > 0 else 'no'}{f' ({secure_timeout}s)' if secure_timeout > 0 else ''}")
    if have_calendar:
        print(f"     Calendar min confidence: {args.cal_threshold}%")
    print(f"     Last UID: {last_uid}", flush=True)

    while True:
        try:
            con = connect(creds)
            has_idle = supports_idle(con) and not args.no_idle
            if has_idle:
                print(f"  [{datetime.datetime.now():%H:%M:%S}] {c('IMAP IDLE', Style.CYAN)} mode active.", flush=True)
            else:
                print(f"  [{datetime.datetime.now():%H:%M:%S}] {c('Polling', Style.DIM)} mode ({interval}s).", flush=True)

            while True:
                if has_idle:
                    res = wait_for_code_idle(con, window, since_uid=last_uid,
                                             known_senders_only=args.known_senders,
                                             idle_timeout=interval)
                else:
                    res = find_newest_code(con, window, since_uid=last_uid,
                                           known_senders_only=args.known_senders)
                    con.noop()
                    time.sleep(interval)

                if res:
                    now_ts = datetime.datetime.now().strftime("%H:%M:%S")

                    # ── Handle code ──
                    if res["code"]:
                        dedup_key = f"{_sender_domain(res['sender'])}:{_code_hash(res['code'])}"
                        if dedup_key in seen_codes:
                            print(f"  [{now_ts}] skipped duplicate {res['code']} from {res['sender']}", flush=True)
                            last_uid = max(last_uid, res["uid"])
                            continue

                        try:
                            if secure_timeout > 0:
                                secure_copy_clipboard(res["code"], timeout=secure_timeout)
                                notify("Verification code copied ✅",
                                       f"{res['code']}  —  {res['subject']}\nFrom: {res['sender']}\nAuto-erase in {secure_timeout}s")
                            else:
                                copy_clipboard(res["code"])
                                notify("Verification code copied ✅",
                                       f"{res['code']}  —  {res['subject']}\nFrom: {res['sender']}")
                            log_event(res["sender"], res["subject"], code=res["code"])
                            secure_label = f" 🔒{secure_timeout}s" if secure_timeout > 0 else ""
                            print(c(f"  [{now_ts}] 📋 Copied {res['code']} from {res['sender']} "
                                  f"({res['confidence']}%){secure_label}", Style.GREEN), flush=True)
                        except RuntimeError as e:
                            print(f"  [{now_ts}] clipboard error: {e}", file=sys.stderr, flush=True)
                            log_event(res["sender"], res["subject"], code=res["code"])

                        last_uid = res["uid"]
                        seen_codes.add(dedup_key)
                        if len(seen_codes) > 50:
                            seen_codes = set(list(seen_codes)[-50:])

                    # ── Handle events ──
                    if res["events"] and have_calendar:
                        for ev in res["events"]:
                            ev_key = f"{res['uid']}:{ev['start']}"
                            if ev_key in seen_events:
                                continue
                            if ev["confidence"] >= args.cal_threshold:
                                # Check if it's a real event (not just any date)
                                link = add_event_to_calendar(ev)
                                if link:
                                    seen_events.add(ev_key)
                                    log_event(res["sender"], res["subject"], event=ev["title"])
                                    msg = f"📅  {ev['title']} @ {ev['start'][:16]}"
                                    notify("Event added to calendar", msg)
                                    print(c(f"  [{now_ts}] {msg}", Style.CYAN), flush=True)
                                    # Keep seen_events bounded
                                    if len(seen_events) > 50:
                                        seen_events = set(list(seen_events)[-50:])

                    # ── Handle subscriptions ──
                    if args.subscriptions:
                        sub = extract_subscription(res["body"], res["subject"], res["sender"])
                        if sub:
                            dedup_key = _subscription_key(sub)
                            if dedup_key not in seen_subscriptions:
                                seen_subscriptions.add(dedup_key)
                                save_subscription(sub)
                                log_event(res["sender"], res["subject"], event=f"sub:{sub['service']}")
                                msg = f"💳  {sub['service']}"
                                if sub["amount"]:
                                    msg += f" {sub['amount']}"
                                if sub["billing_cycle"]:
                                    msg += f"/{sub['billing_cycle']}"
                                if sub["next_billing"]:
                                    msg += f" → renews {sub['next_billing']}"
                                elif sub["trial_end"]:
                                    msg += f" → trial ends {sub['trial_end']}"
                                notify("Subscription detected", msg)
                                print(c(f"  [{now_ts}] {msg}", Style.MAGENTA), flush=True)
                                # Keep bounded
                                if len(seen_subscriptions) > 50:
                                    seen_subscriptions = set(list(seen_subscriptions)[-50:])

                    # Update state (even if only UID advanced)
                    last_uid = max(last_uid, res["uid"])
                    save_state({
                        "last_uid": last_uid,
                        "seen_codes": list(seen_codes),
                        "seen_events": list(seen_events),
                        "seen_subscriptions": list(seen_subscriptions),
                        "last_time": datetime.datetime.now().isoformat(),
                    })

        except (imaplib.IMAP4.error, ssl.SSLError, socket.error, OSError) as e:
            print(f"  [{datetime.datetime.now():%H:%M:%S}] connection error: {e}; retrying…",
                  file=sys.stderr, flush=True)
            time.sleep(max(interval, 10))
        except KeyboardInterrupt:
            print(c("\n  ⏹  Daemon stopped.", Style.YELLOW), flush=True)
            break


def scan_mode(args):
    """Scan inbox for events with dates/times (no code copy)."""
    creds = load_creds()
    window = datetime.timedelta(minutes=args.minutes)
    con = connect(creds)
    print(c(f"  🔍  Scanning inbox for events (last {args.minutes} min)...", Style.CYAN, Style.BOLD))
    print()

    try:
        res = find_newest_code(con, window, since_uid=0,
                               known_senders_only=args.known_senders)
    finally:
        try:
            con.close()
        except Exception:
            pass
        con.logout()

    if not res:
        print("  No emails found in the scan window.")
        return

    if res["code"]:
        print(c(f"  📋  Code found: {res['code']}", Style.GREEN, Style.BOLD))
        print(f"     From: {res['sender']}")
        print(f"     Subject: {res['subject']}")
        print(f"     Confidence: {res['confidence']}% ({res['method']})")
        print()

    if res["events"]:
        print(c(f"  📅  Events found: {len(res['events'])}", Style.CYAN, Style.BOLD))
        print()
        for i, ev in enumerate(res["events"], 1):
            conf_bar = "█" * (ev["confidence"] // 10) + "░" * (10 - ev["confidence"] // 10)
            print(f"  {i}. {c(ev['title'], Style.BOLD)}")
            print(f"     {c('When:', Style.DIM)} {ev['start'][:16]} → {ev['end'][:16]}")
            if ev.get("location"):
                print(f"     {c('Where:', Style.DIM)} {ev['location']}")
            print(f"     {c('Type:', Style.DIM)} {ev['event_type']}  "
                  f"|  {c('Confidence:', Style.DIM)} {conf_bar} {ev['confidence']}%")
            print()
    else:
        print("  No events with dates/times found.")
        print("  Tip: Try --minutes 60 to scan a wider window.")
        print()

    # ── Handle subscriptions ──
    if args.subscriptions and res["body"]:
        sub = extract_subscription(res["body"], res["subject"], res["sender"])
        if sub:
            print(c("  💳  Subscription detected:", Style.MAGENTA, Style.BOLD))
            print()
            print(f"     {format_subscription(sub)}")
            print()
            # Save it
            save_subscription(sub)
            print(c("  ✅  Subscription saved to tracker.", Style.GREEN))
            print(c("  Run: verify-code subscriptions  (to view all tracked)", Style.DIM))
            print()
        else:
            print("  💳  No subscription info detected in this email.")
            print()


