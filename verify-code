def update_self():
    """Update verify-code to the latest version from GitHub."""
    print()
    print(c("  ╔══════════════════════════════════════════╗", Style.CYAN, Style.BOLD))
    print(c("  ║   🔄  Updating verify-code…              ║", Style.CYAN, Style.BOLD))
    print(c("  ╚══════════════════════════════════════════╝", Style.CYAN, Style.BOLD))
    print()

    url = "https://raw.githubusercontent.com/aakashjabraham-hue/verify-code/main/verify-code"
    local_script = os.path.expanduser("~/.local/bin/verify-code")
    local_bin = os.path.expanduser("~/.local/bin")

    # Check for curl
    if subprocess.run(["which", "curl"], capture_output=True).returncode != 0:
        print(c("  ✗  curl is required for updates.", Style.RED))
        print("  Install it: sudo apt install curl")
        return

    os.makedirs(local_bin, exist_ok=True)

    try:
        # Use # flag for progress bar, -L for redirects, -f for fail
        # Let output flow to terminal so the user sees the bar
        result = subprocess.run(
            ["curl", "-#", "-fL", "-o", local_script, url],
            capture_output=False, timeout=60
        )
        if result.returncode != 0:
            print(c(" ✗", Style.RED))
            print(c("  ✗  Download failed (curl error)", Style.RED))
            print()
            print("  Try the one-liner instead:")
            print(c("    curl -fL https://raw.githubusercontent.com/", Style.BOLD))
            print(c("      aakashjabraham-hue/verify-code/main/verify-code \\", Style.BOLD))
            print(c("      -o ~/.local/bin/verify-code && chmod +x ~/.local/bin/verify-code", Style.BOLD))
            return

        os.chmod(local_script, 0o755)
        print(c(" ✅  Downloaded!", Style.GREEN))

        # Get the new version
        try:
            with open(local_script) as f:
                for line in f:
                    if line.startswith("__version__"):
                        new_ver = line.split('"')[1]
                        break
        except Exception:
            new_ver = "?"

        print(c(f"  ✅  Updated to version {new_ver}!", Style.GREEN, Style.BOLD))
        print(f"  Saved to: {local_script}")
        print()
        print("  Run any command to use the new version. 🚀")

    except subprocess.TimeoutExpired:
        print(c(" ✗", Style.RED))
        print(c("  ✗  Download timed out. Check your internet connection.", Style.RED))
    except Exception as e:
        print(c(" ✗", Style.RED))
        print(c(f"  ✗  Update failed: {e}", Style.RED))


