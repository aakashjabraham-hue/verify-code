# ── Code extraction regexes ────────────────────────────────────────────
# Common code patterns seen in 2FA emails
RE_EXPLICIT = re.compile(
    r"(?:verification|confirm(?:ation)?|otp|one[- ]?time|security|login|log[- ]?in|"
    r"sign[- ]?in|signup|sign[- ]?up|activate|access|2fa|two[- ]?factor|account|"
    r"passcode|magic|mfa|multi[- ]?factor|auth|authenticator|temporary)\b"
    r"[\s:=-]*(?:code|pin|number|token|link|key)?[\s:=-]*(?:is|[:=])?\s*"
    r"(?=[A-Za-z0-9-]*\d)([A-Za-z0-9]{3,8}(?:[- ][A-Za-z0-9]{3,8})?)",
    re.I,
)

# Alphanumeric codes like ABC-123 or A1B2C3
RE_ALPHANUM = re.compile(r"\b([A-Z0-9]{2,8}(?:-|_)?[A-Z0-9]{2,8})\b")

# Grouped 3+3 digits (e.g. "123 456" or "123-456")
RE_GROUPED = re.compile(r"\b([0-9]{3}[ -][0-9]{3})\b")

# Bare 5-8 digit codes
RE_PLAIN_STRICT = re.compile(r"\b([0-9]{5,8})\b")

# Bare 4-digit codes — ONLY with strong context
RE_PLAIN_4 = re.compile(r"\b([0-9]{4})\b")

# Context words that make a code plausible
CONTEXT_WORDS = re.compile(
    r"verif|confirm|otp|code|security|log[- ]?in|sign[- ]?in|activate|2fa|"
    r"two[- ]?factor|one[- ]?time|one-time|pin|token|authenticator|"
    r"mfa|multi[- ]?factor|passcode|magic|auth|temporary",
    re.I,
)

# ── Date/time extraction patterns ──────────────────────────────────────
# These patterns look for structured event info in email bodies

# Pattern: date/time in various formats
# Matches: "on June 15", "Date: June 15", "June 15, 2026 at 2:30 PM",
# "Friday, August 14, 2026", "Departure: July 20, 2026 at 6:45 AM"
RE_DATE_FULL = re.compile(
    r"(?:(?:on|for|date|time|when|departure|arrival|check[- ]?in|checkout|"
    r"starts|start|begins|begin|scheduled|confirmed|reserved)\s*[:]?\s*)?"
    r"("
    r"(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun|Monday|Tuesday|Wednesday|Thursday|"
    r"Friday|Saturday|Sunday)[, ]+\s*"
    r"(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|"
    r"Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
    r"\s+\d{1,2}(?:st|nd|rd|th)?"
    r"(?:,?\s*\d{4})?"
    r")"
    r"(?:\s+(?:at\s+)?"
    r"(\d{1,2}(?::\d{2})?\s*(?:[ap]\.?\s*m\.?|AM|PM|am|pm)?)"
    r")?",
    re.I,
)

# Pattern: "[Month] [Day], [Year]" without day-of-week
RE_DATE_MONTH_DAY = re.compile(
    r"(?:(?:on|for|date|time|when|departure|arrival|check[- ]?in|checkout|"
    r"starts|start|begins|begin|scheduled|confirmed|reserved)\s*[:]?\s*)?"
    r"("
    r"(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|"
    r"Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
    r"\s+\d{1,2}(?:st|nd|rd|th)?"
    r"(?:,?\s*\d{4})?"
