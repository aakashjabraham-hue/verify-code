def _which(name):
    """Cross-platform: find an executable in PATH."""
    if IS_WINDOWS:
        cmd = ["where", name]
    else:
        cmd = ["which", name]
    return subprocess.run(cmd, capture_output=True, timeout=5).returncode == 0

def _chmod_600(path):
    """Set restrictive permissions on a file. No-op on Windows."""
    if not IS_WINDOWS:
        os.chmod(path, 0o600)

def _chmod_644(path):
    """Set readable permissions on a file. No-op on Windows."""
    if not IS_WINDOWS:
        os.chmod(path, 0o644)

def _chmod_755(path):
    """Set executable permissions on a file. No-op on Windows."""
    if not IS_WINDOWS:
        os.chmod(path, 0o755)

