# IMAP / Email
# ═══════════════════════════════════════════════════════════════════════

def connect(creds):
    ctx = ssl.create_default_context()
    con = imaplib.IMAP4_SSL(creds["host"], int(creds["port"]), ssl_context=ctx)
    con.login(creds["email"], creds["password"])
    con.select("INBOX")
    return con


def find_newest_code(con, window, since_uid=0, known_senders_only=False):
    """Return dict with code, sender, subject, age, uid, confidence, method, events."""
    now = datetime.datetime.now(datetime.timezone.utc)
    uids = []
    try:
        typ, data = con.search(None, "X-GM-RAW", f"newer_than:{int(window.total_seconds() // 60)}m")
        if typ == "OK" and data and data[0]:
            uids = data[0].split()
    except imaplib.IMAP4.error:
        uids = []
    if not uids:
        since = (now - window).strftime("%d-%b-%Y")
        try:
            typ, data = con.search(None, "SINCE", since)
            if typ == "OK" and data and data[0]:
                uids = data[0].split()
        except imaplib.IMAP4.error:
            pass
    if not uids:
        return None

    for uid in reversed(uids):
        uid_int = int(uid)
        if uid_int <= since_uid:
            continue
        uid_s = str(uid_int)
        try:
            typ, data = con.fetch(uid_s, "(BODY.PEEK[HEADER])")
            if typ != "OK":
                continue
            head = email.message_from_bytes(data[0][1])
            sender = head.get("From", "")
            subject = head.get("Subject", "") or ""

            if known_senders_only and not is_known_sender(sender):
                continue

            date = parsedate_to_datetime(head.get("Date", ""))
            if date is None:
                continue
            if date.tzinfo is None:
                date = date.replace(tzinfo=datetime.timezone.utc)
            age = now - date.astimezone(datetime.timezone.utc)
            if age > window:
                continue

            typ, data = con.fetch(uid_s, "(BODY.PEEK[])")
            if typ != "OK":
                continue
            msg = email.message_from_bytes(data[0][1])
            body = get_plain(msg)

            result = extract_code(body, subject, sender)
            events = extract_datetime(body, subject, sender) if DATEUTIL_AVAILABLE else []

            return {
                "code": result["code"] if result else None,
                "confidence": result["confidence"] if result else 0,
                "method": result["method"] if result else None,
                "sender": sender,
                "subject": subject,
                "age": age,
                "uid": uid,
                "events": events,
                "body": body,
            }
        except (imaplib.IMAP4.error, ssl.SSLError, socket.error, OSError):
            continue
    return None


def wait_for_code_idle(con, window, since_uid=0, known_senders_only=False, idle_timeout=1200):
    """Use IMAP IDLE to wait for new mail, then check for a code/event."""
    while True:
        try:
            typ, data = con.idle()
            if typ != "OK":
                return None
            now = time.time()
            con.settimeout(idle_timeout)
            con.idle()
            time.sleep(0.5)
            typ, data = con.idle()
            res = find_newest_code(con, window, since_uid, known_senders_only)
            if res:
                return res
        except (imaplib.IMAP4.error, ssl.SSLError, socket.error, OSError, AttributeError):
            return None


def supports_idle(con):
    try:
        typ, data = con.capability()
        caps = data[0].decode() if isinstance(data[0], bytes) else data[0]
        return "IDLE" in caps.upper()
    except Exception:
        return False


