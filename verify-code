"""
    )
    p.add_argument("cmd", nargs="?", default="run",
                   choices=["run", "setup", "daemon", "install", "uninstall", "update", "scan", "auth", "version", "history", "subscriptions", "dashboard", "fill"],
                   help="run (default) | setup | daemon | install | uninstall | update | scan | auth | version | history | subscriptions | dashboard | fill")
