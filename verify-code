def extract_code(text, subject="", sender=""):
    combined = f"{subject} {sender} {text[:2000]}"
    has_context = bool(CONTEXT_WORDS.search(combined))
    known_sender = is_known_sender(sender)

    m = RE_EXPLICIT.search(text)
    if m:
        raw = m.group(1)
        cleaned = raw.replace(" ", "").replace("-", "")
        if len(cleaned) >= 4:
            return {"code": cleaned, "confidence": 95, "method": "explicit_label"}

    if has_context or known_sender:
        m = RE_GROUPED.search(text)
        if m:
            cleaned = m.group(1).replace(" ", "").replace("-", "")
            return {"code": cleaned, "confidence": 88, "method": "grouped_3_3"}

    if known_sender and has_context:
        for m in RE_ALPHANUM.finditer(text):
            code = m.group(1)
            if len(code) >= 4 and len(code) <= 12:
                return {"code": code, "confidence": 80, "method": "alphanumeric"}

    m = RE_PLAIN_STRICT.search(text)
    if m:
        score = 65 if known_sender else 45
        if has_context:
            score += 15
        return {"code": m.group(1), "confidence": score, "method": "bare_digits"}

    if known_sender and has_context:
        m = RE_PLAIN_4.search(text)
        if m:
            code = m.group(1)
            idx = text.find(code)
            nearby = text[max(0, idx - 80):idx + len(code) + 80]
            if CONTEXT_WORDS.search(nearby):
                return {"code": code, "confidence": 55, "method": "short_4_digit"}
    return None

def extract_datetime(text, subject="", sender=""):
    events = []
    body = text[:5000]
    if not DATEUTIL_AVAILABLE:
        return events

    event_type = "event"
    body_lower = body.lower() + " " + subject.lower()
    type_scores = {}
    for etype, keywords in EVENT_KEYWORDS.items():
        score = sum(1 for kw in keywords if kw in body_lower)
        if score > 0:
            type_scores[etype] = score
    if type_scores:
        event_type = max(type_scores, key=type_scores.get)

    title = subject.strip()
    title_clean = re.sub(r"^(?:Re:|Fwd?|Confirmed|Reminder|Your|Upcoming|Scheduled|New:?\s*)+", "", title, flags=re.I).strip(" :,;-\"'")
    if not title_clean:
        title_clean = event_type.capitalize()

    location = None
    loc_patterns = [
        re.compile(r"(?:at|in|location|venue|address)[:\s]+([A-Za-z0-9\s,.'\-]+?)(?:\.|$|\n)", re.I),
        re.compile(r"(?:located at|meet at|arrive at)[:\s]+([A-Za-z0-9\s,.'\-]+?)(?:\.|$|\n)", re.I),
    ]
    for pat in loc_patterns:
        m = pat.search(body)
        if m:
            loc = m.group(1).strip()
            if 3 < len(loc) < 100:
                location = loc
                break

    now = datetime.datetime.now()
    found_dates = []

    for m in RE_DATE_FULL.finditer(body):
        date_str = m.group(1)
        time_str = m.group(2) if m.lastindex >= 2 and m.group(2) else None
        full_str = date_str + (" " + time_str if time_str else "")
        full_str = full_str.rstrip(".,;:!?")
        try:
            dt = dateparser.parse(full_str, fuzzy=True, default=now)
            if dt and dt > datetime.datetime(2000, 1, 1):
                found_dates.append((dt, 85, m.group(0)))
        except (ValueError, TypeError):
            pass

    seen_dates = set()
    for m in RE_DATE_MONTH_DAY.finditer(body):
        date_str = m.group(1)
        time_str = m.group(2) if m.lastindex >= 2 and m.group(2) else None
        full_str = date_str + (" " + time_str if time_str else "")
        full_str = full_str.rstrip(".,;:!?")
        try:
            dt = dateparser.parse(full_str, fuzzy=True, default=now)
            if dt and dt > datetime.datetime(2000, 1, 1):
                key = dt.strftime("%Y%m%d%H%M")
                if key not in seen_dates:
                    found_dates.append((dt, 80, m.group(0)))
                    seen_dates.add(key)
        except (ValueError, TypeError):
            pass

    for m in RE_DATE_ISO.finditer(body):
        try:
            dt = dateparser.parse(m.group(1), fuzzy=False)
            if dt:
                nearby = body[m.end():m.end() + 60]
                time_m = RE_TIME.search(nearby)
                if time_m:
                    try:
                        full = f"{m.group(1)} {time_m.group(1)}"
                        dt = dateparser.parse(full, fuzzy=False)
                    except (ValueError, TypeError):
                        pass
                found_dates.append((dt, 70, m.group(0)))
        except (ValueError, TypeError):
            pass

    for m in RE_DATE_US.finditer(body):
        parts = m.group(1).replace("-", "/").split("/")
        if len(parts) == 3:
            try:
                parts = [int(p) for p in parts]
                if 1 <= parts[0] <= 12 and 1 <= parts[1] <= 31 and parts[2] >= 2020:
                    nearby = body[m.end():m.end() + 60]
                    time_m = RE_TIME.search(nearby)
                    dt = datetime.datetime(parts[2], parts[0], parts[1])
                    if time_m:
                        try:
                            full = f"{m.group(1)} {time_m.group(1)}"
                            dt = dateparser.parse(full, fuzzy=False)
                        except (ValueError, TypeError):
                            dt = dt.replace(hour=12)
                    else:
                        dt = dt.replace(hour=12)
                    found_dates.append((dt, 60, m.group(0)))
            except (ValueError, TypeError):
                pass

    seen = set()
    unique_dates = []
    for dt, conf, match_str in found_dates:
        key = dt.strftime("%Y%m%d%H%M")
        if key not in seen:
            seen.add(key)
            unique_dates.append((dt, conf, match_str))

    unique_dates.sort(key=lambda x: -x[1])

    for dt, conf, match_str in unique_dates:
        if dt < now - datetime.timedelta(days=1):
            continue

        end_dt = None
        try:
            pos = body.lower().find(match_str.lower())
            if pos != -1:
                time_text = body[max(0, pos - 20):pos + len(match_str) + 120]
            else:
                time_text = body
            range_m = re.search(r"(?:to|-|–|until)\s*(\d{1,2}(?::\d{2})?\s*(?:[ap]\.?\s*m\.?|AM|PM|am|pm)?)", time_text, re.I)
            if range_m:
                try:
                    end_str = dt.strftime("%Y-%m-%d") + " " + range_m.group(1)
                    end_dt = dateparser.parse(end_str, fuzzy=False)
                except (ValueError, TypeError):
                    pass
        except Exception:
            pass

        if end_dt is None:
            end_dt = dt + datetime.timedelta(hours=1)

        event = {
            "title": title_clean[:80],
            "start": dt.isoformat(),
            "end": end_dt.isoformat(),
            "location": location,
            "confidence": conf,
            "event_type": event_type,
            "source": "email",
        }
        events.append(event)

    return events

def extract_subscription(text, subject="", sender="") -> dict | None:
    body = text[:5000]
    combined = f"{subject} {sender} {body}"

    if not SUBSCRIPTION_KEYWORDS.search(combined):
        return None

    service_name = _lookup_service_name(sender)
    known_sender = service_name is not None
    body_lower = body.lower() + " " + subject.lower()

    status = "active"
    if re.search(r"(?:trial|free trial|trial period|trial ends|trial ending)", combined, re.I):
        status = "trial"
    if re.search(r"(?:cancelled|canceled|cancelling|canceling|cancellation|cancel your|you cancelled|has been cancelled)", combined, re.I):
        status = "cancelled"

    amount = None
    amt_matches = RE_AMOUNT.findall(body)
    if amt_matches:
        amount = f"${amt_matches[0]}"

    billing_cycle = None
    bc_m = RE_BILLING_CYCLE.search(body)
    if bc_m:
        raw = bc_m.group(1).lower()
        if raw in ("month", "monthly"): billing_cycle = "monthly"
        elif raw in ("year", "yearly", "annual"): billing_cycle = "yearly"
        elif raw in ("week", "weekly"): billing_cycle = "weekly"
        elif raw == "quarterly": billing_cycle = "quarterly"

    plan = None
    plan_m = RE_PLAN_NAME.search(body)
    if plan_m:
        candidate = plan_m.group(1).strip()
        if len(candidate) < 30 and not re.search(r"\b(?:will|your|this|that|has|have|been|with|for|the|and|our|we|you|to|is|are|was|on|at|it|in)\b", candidate, re.I):
            plan = candidate
    if plan is None:
        plan_m2 = re.search(r"(?:the|your|our|this)\s+([A-Za-z][A-Za-z0-9\s.'\-+]{1,20}?)\s+(?:plan|tier|level|package|subscription)\b", body, re.I)
        if plan_m2:
            candidate = plan_m2.group(1).strip()
            if len(candidate) < 30:
                plan = candidate

    next_billing = None
    trial_end = None

    if DATEUTIL_AVAILABLE:
        now = datetime.datetime.now()
        for m in RE_SUB_DATE.finditer(body):
            try:
                dt = dateparser.parse(m.group(1), fuzzy=False, default=now)
                if dt and dt > datetime.datetime(2000, 1, 1):
                    iso = dt.strftime("%Y-%m-%d")
                    ctx = body[max(0, m.start() - 60):m.end() + 60].lower()
                    if re.search(r"(?:trial ends|trial ending|trial period ends|free trial ends|trial expires)", ctx):
                        trial_end = iso
                    elif status == "trial":
                        trial_end = iso
                    else:
                        next_billing = iso
            except (ValueError, TypeError):
                pass

        for m in RE_SUB_DATE_ISO.finditer(body):
            try:
                dt = dateparser.parse(m.group(1), fuzzy=False)
                if dt and dt > datetime.datetime(2000, 1, 1):
                    if trial_end is None:
                        ctx = body[max(0, m.start() - 60):m.end() + 60].lower()
                        if re.search(r"(?:trial|free)", ctx):
                            trial_end = dt.strftime("%Y-%m-%d")
                    if next_billing is None:
                        next_billing = dt.strftime("%Y-%m-%d")
            except (ValueError, TypeError):
                pass

        for m in RE_SUB_DATE_US.finditer(body):
            try:
                parts = m.group(1).replace("-", "/").split("/")
                parts = [int(p) for p in parts]
                if 1 <= parts[0] <= 12 and 1 <= parts[1] <= 31 and parts[2] >= 2020:
                    dt = datetime.datetime(parts[2], parts[0], parts[1])
                    if trial_end is None:
                        ctx = body[max(0, m.start() - 60):m.end() + 60].lower()
                        if re.search(r"(?:trial|free)", ctx):
                            trial_end = dt.strftime("%Y-%m-%d")
                    if next_billing is None:
                        next_billing = dt.strftime("%Y-%m-%d")
            except (ValueError, TypeError):
                pass

        if next_billing is None and trial_end is None:
            for pat in [
                re.compile(r"(?:renews|will renew|next renewal|next billing)[:\s]+((?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\s+\d{1,2}(?:st|nd|rd|th)?,?\s*\d{4})", re.I),
                re.compile(r"(?:charged|payment|billed)[:\s]+(?:on|the)\s+((?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\s+\d{1,2}(?:st|nd|rd|th)?,?\s*\d{4})", re.I),
            ]:
                m = pat.search(body)
                if m:
                    try:
                        dt = dateparser.parse(m.group(1), fuzzy=False, default=now)
                        if dt and dt > datetime.datetime(2000, 1, 1):
                            next_billing = dt.strftime("%Y-%m-%d")
                            break
                    except (ValueError, TypeError):
                        pass

    confidence = 0
    if known_sender: confidence += 30
    if amount: confidence += 20
    if billing_cycle: confidence += 15
    if next_billing or trial_end: confidence += 20
    if plan: confidence += 10
    if status == "trial": confidence += 5

    if not known_sender and not amount:
        confidence = max(confidence, 15)

    if confidence < 20:
        return None

    confidence = min(confidence, 98)

    if service_name is None:
        domain = _sender_domain(sender)
        for prefix in ["mail.", "message.", "noreply.", "accounts.", "account.", "e."]:
            if domain.startswith(prefix):
                domain = domain[len(prefix):]
                break
        service_name = domain.split(".")[0].title()

    return {
        "service": service_name or "Unknown",
        "plan": plan,
        "amount": amount,
        "billing_cycle": billing_cycle,
        "next_billing": next_billing,
        "trial_end": trial_end,
        "status": status,
        "confidence": confidence,
        "source": "email",
        "sender": sender,
        "subject": subject,
    }

def format_subscription(sub, warn=False) -> str:
    parts = [c(sub["service"], Style.BOLD, Style.CYAN) if not warn else c(sub["service"], Style.BOLD, Style.YELLOW)]
    if sub["plan"]: parts.append(f"({sub['plan']})")
    if sub["amount"]: parts.append(sub["amount"])
    if sub["billing_cycle"]: parts.append(f"/{sub['billing_cycle']}")
    if sub["next_billing"]: parts.append(f"→ renews {sub['next_billing']}")
    if sub["trial_end"]: parts.append(c(f"⚠ trial ends {sub['trial_end']}", Style.YELLOW) if warn else f"trial ends {sub['trial_end']}")
    if sub["status"] == "cancelled": parts.append(c("❌ cancelled", Style.RED, Style.BOLD))
    conf_bar = "█" * (sub["confidence"] // 10) + "░" * (10 - sub["confidence"] // 10)
    parts.append(c(f"({conf_bar} {sub['confidence']}%)", Style.DIM))
    return "  ".join(parts)

def check_subscription_warnings(subscriptions: list[dict], warn_days: int = 3) -> list[dict]:
    now = datetime.datetime.now().date()
    warnings = []
    for sub in subscriptions:
        if sub.get("next_billing"):
            try:
                renew_date = datetime.datetime.strptime(sub["next_billing"], "%Y-%m-%d").date()
                days_until = (renew_date - now).days
                if 0 <= days_until <= warn_days:
                    warnings.append({**sub, "warn_type": "renewal", "days_until": days_until})
            except ValueError:
                pass
        if sub.get("trial_end"):
            try:
                trial_date = datetime.datetime.strptime(sub["trial_end"], "%Y-%m-%d").date()
                days_until = (trial_date - now).days
                if 0 <= days_until <= warn_days:
                    warnings.append({**sub, "warn_type": "trial_end", "days_until": days_until})
            except ValueError:
                pass
    return warnings

