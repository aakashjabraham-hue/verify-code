# ── Form Filler Encryption ────────────────────────────────────────────────────

def _get_fernet() -> Fernet | None:
    if not FORM_FILLER_AVAILABLE:
        return None
    key = keyring.get_password(KEYRING_SERVICE, KEYRING_USER)
    if not key:
        key = Fernet.generate_key().decode()
        keyring.set_password(KEYRING_SERVICE, KEYRING_USER, key)
    return Fernet(key.encode())

def save_form_data(data: dict):
    f = _get_fernet()
    if not f:
        print(c("  ✗  Form filler dependencies missing. Install with: pip install keyring cryptography", Style.RED))
        return False
    raw = json.dumps(data).encode()
    enc = f.encrypt(raw)
    with open(FORM_DATA_FILE, "wb") as file:
        file.write(enc)
    _chmod_600(FORM_DATA_FILE)
    return True

def load_form_data() -> dict:
    if not os.path.exists(FORM_DATA_FILE):
        return {}
    f = _get_fernet()
    if not f:
        return {}
    try:
        with open(FORM_DATA_FILE, "rb") as file:
            enc = file.read()
        raw = f.decrypt(enc)
        return json.loads(raw)
    except Exception:
        return {}

