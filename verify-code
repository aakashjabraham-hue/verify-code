  return dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
function fmtTime(d) {
  if (!d) return '';
  const dt = new Date(d);
  if (isNaN(dt.getTime())) return '';
  return dt.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
}
function daysUntil(dateStr) {
  if (!dateStr) return null;
  const target = new Date(dateStr + 'T00:00:00');
  const now = new Date();
  now.setHours(0,0,0,0);
  return Math.ceil((target - now) / 86400000);
}
function warnFlag(days) {
  if (days === null || days === undefined) return '';
  if (days < 0) return '<span class="dim">past</span>';
  if (days === 0) return '<span class="flag-warn">due today</span>';
  if (days <= 3) return `<span class="flag-warn">${days}d left</span>`;
  if (days <= 10) return `<span class="flag-soon">${days}d</span>`;
  return `<span class="flag-far">${days}d</span>`;
}
function statusStamp(status) {
  if (status === 'trial') return '<span class="stamp stamp-trial">Trial</span>';
  if (status === 'cancelled') return '<span class="stamp stamp-cancelled">Cancelled</span>';
  return '<span class="stamp stamp-active">Active</span>';
}
function esc(s) {
  return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
}
function isMagicLink(raw) { return typeof raw === 'string' && raw.startsWith('LINK:'); }
function formatCodeOrLink(raw) {
  if (!raw) return '<span class="dim">?</span>';
  if (isMagicLink(raw)) {
    const url = raw.substring(5);
    let host = url;
    try { host = new URL(url).hostname.replace(/^www\./, ''); } catch (e) { /* leave as-is */ }
    return `<a class="link-chip" href="${esc(url)}" target="_blank" rel="noopener noreferrer" title="${esc(url)}"><span class="arrow">↗</span><span class="host">${esc(host)}</span></a>`;
  }
  return `<span class="code-cell">${esc(raw)}</span>`;
}
