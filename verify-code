# Date/Time + Event Extraction
# ═══════════════════════════════════════════════════════════════════════

def extract_datetime(text, subject="", sender=""):
    """Extract date/time info from an email body.

    Returns list of event dicts with:
      - title: str
      - start: ISO datetime string
      - end: ISO datetime string (or None)
      - location: str (or None)
      - confidence: 0-100
      - event_type: str
      - source: str
    """
    events = []
    body = text[:5000]  # Look at first 5K chars
    combined = f"{subject} {sender} {body}"

    if not DATEUTIL_AVAILABLE:
        return events

    # --- Detect event type ---
    event_type = "event"
    body_lower = body.lower() + " " + subject.lower()
    type_scores = {}
    for etype, keywords in EVENT_KEYWORDS.items():
        score = sum(1 for kw in keywords if kw in body_lower)
        if score > 0:
            type_scores[etype] = score
    if type_scores:
        event_type = max(type_scores, key=type_scores.get)

    # --- Extract title ---
    title = subject.strip()
    # Clean up subject: remove common prefixes
    title_clean = re.sub(
        r"^(?:Re:|Fwd?|Confirmed|Reminder|Your|Upcoming|Scheduled|New)",
        "", title, flags=re.I
    ).strip(" :,;-\"'")
    if not title_clean:
        title_clean = event_type.capitalize()

    # --- Extract location ---
    location = None
    loc_patterns = [
        re.compile(r"(?:at|in|location|venue|address)[:\s]+([A-Za-z0-9\s,.'\-]+?)(?:\.|$|\n)", re.I),
        re.compile(r"(?:located at|meet at|arrive at)[:\s]+([A-Za-z0-9\s,.'\-]+?)(?:\.|$|\n)", re.I),
    ]
    for pat in loc_patterns:
        m = pat.search(body)
        if m:
            loc = m.group(1).strip()
            if len(loc) > 3 and len(loc) < 100:
                location = loc
                break

    # --- Search for dates ---
    now = datetime.datetime.now()
    found_dates = []

    # Method 1: "on [date] at [time]" patterns (with day-of-week)
    for m in RE_DATE_FULL.finditer(body):
        date_str = m.group(1)
        time_str = m.group(2) if m.lastindex >= 2 and m.group(2) else None
        full_str = date_str
        if time_str:
            full_str += " " + time_str
        # Strip trailing punctuation that might confuse dateparser
        full_str = full_str.rstrip(".,;:!?")
        try:
            dt = dateparser.parse(full_str, fuzzy=True, default=now)
            if dt and dt > datetime.datetime(2000, 1, 1):
                found_dates.append((dt, 85))
        except (ValueError, TypeError):
            pass

    # Method 1b: "[Month] [Day], [Year]" patterns (no day-of-week)
    seen_dates = set()
    for m in RE_DATE_MONTH_DAY.finditer(body):
        date_str = m.group(1)
        time_str = m.group(2) if m.lastindex >= 2 and m.group(2) else None
        full_str = date_str
        if time_str:
            full_str += " " + time_str
        full_str = full_str.rstrip(".,;:!?")
        try:
            dt = dateparser.parse(full_str, fuzzy=True, default=now)
            if dt and dt > datetime.datetime(2000, 1, 1):
                # Check not already found
                key = dt.strftime("%Y%m%d%H%M")
                if key not in seen_dates:
                    found_dates.append((dt, 80))
                    seen_dates.add(key)
        except (ValueError, TypeError):
            pass

    # Method 2: ISO dates (2024-07-15)
    for m in RE_DATE_ISO.finditer(body):
        try:
            dt = dateparser.parse(m.group(1), fuzzy=False)
            if dt:
                # Check for time nearby
                nearby = body[m.end():m.end() + 60]
                time_m = RE_TIME.search(nearby)
                if time_m:
                    try:
                        full = f"{m.group(1)} {time_m.group(1)}"
                        dt = dateparser.parse(full, fuzzy=False)
                    except (ValueError, TypeError):
                        pass
                found_dates.append((dt, 70))
        except (ValueError, TypeError):
            pass

    # Method 3: US-style dates (7/15/2024)
    for m in RE_DATE_US.finditer(body):
        # Only if it's actually a date (not just numbers)
        parts = m.group(1).replace("-", "/").split("/")
        if len(parts) == 3:
            try:
                parts = [int(p) for p in parts]
                if parts[0] <= 12 and parts[0] >= 1 and parts[1] <= 31 and parts[2] >= 2020:
                    # Check for time nearby
                    nearby = body[m.end():m.end() + 60]
                    time_m = RE_TIME.search(nearby)
                    dt = datetime.datetime(parts[2], parts[0], parts[1])
                    if time_m:
                        try:
                            full = f"{m.group(1)} {time_m.group(1)}"
                            dt = dateparser.parse(full, fuzzy=False)
                        except (ValueError, TypeError):
                            dt = dt.replace(hour=12)
                    else:
                        dt = dt.replace(hour=12)
                    found_dates.append((dt, 60))
            except (ValueError, TypeError):
                pass

    # Method 4: Fuzzy dateutil parsing of the email body
    if not found_dates:
        # Try to find the first meaningful date in the body
        try:
            dt = dateparser.parse(body, fuzzy=True, default=now)
            if dt and dt > datetime.datetime(2000, 1, 1) and dt < now + datetime.timedelta(days=365):
                found_dates.append((dt, 40))
        except (ValueError, TypeError):
            pass

    # Deduplicate and filter
    seen = set()
    unique_dates = []
    for dt, conf in found_dates:
        key = dt.strftime("%Y%m%d%H%M")
        if key not in seen:
            seen.add(key)
            unique_dates.append((dt, conf))

    # Sort by confidence (highest first)
    unique_dates.sort(key=lambda x: -x[1])

    for dt, conf in unique_dates:
        # Skip if it's too far in the past
        if dt < now - datetime.timedelta(days=1):
            continue

        end_dt = None
        # Check for duration/end time nearby
        time_text = body[max(0, body.lower().find(dt.strftime("%B")) - 20):
                         body.lower().find(dt.strftime("%B")) + 120]
        range_m = re.search(
            r"(?:to|-|–|until)\s*(\d{1,2}(?::\d{2})?\s*(?:[ap]\.?\s*m\.?|AM|PM|am|pm)?)",
            time_text, re.I
        )
        if range_m:
            try:
                end_str = dt.strftime("%Y-%m-%d") + " " + range_m.group(1)
                end_dt = dateparser.parse(end_str, fuzzy=False)
            except (ValueError, TypeError):
                pass

        # Default 1h duration if no end time found
        if end_dt is None:
            end_dt = dt + datetime.timedelta(hours=1)

        event = {
            "title": title_clean[:80],
            "start": dt.isoformat(),
            "end": end_dt.isoformat(),
            "location": location,
            "confidence": conf,
            "event_type": event_type,
            "source": "email",
        }
        events.append(event)

    return events


