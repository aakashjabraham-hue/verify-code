            client_config, CAL_SCOPES,
            redirect_uri="http://localhost:8080/"
        )

        # Start a local server to catch the redirect
        creds = flow.run_local_server(
            port=8080,
            host="localhost",
            open_browser=True,
            success_message="✅ verify-code is now authorized! You can close this tab.",
        )

