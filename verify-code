def connect(creds):
    ctx = ssl.create_default_context()
    con = imaplib.IMAP4_SSL(creds["host"], int(creds["port"]), ssl_context=ctx)
    con.login(creds["email"], creds["password"])
    con.select("INBOX")
    return con


def find_newest_code(con, window, since_uid=0, known_senders_only=False):
    """Return dict with code, sender, subject, age, uid, confidence, method, events, max_uid_seen."""
    now = datetime.datetime.now(datetime.timezone.utc)
    uids = []
    
    # FIX: Removed the X-GM-RAW newer_than:10m search because 'm' means months in Gmail search syntax.
    # We rely entirely on the standard IMAP SINCE date search, which is safe and accurate.
    since = (now - window).strftime("%d-%b-%Y")
    try:
        typ, data = con.uid('SEARCH', None, "SINCE", since)
        if typ == "OK" and data and data[0]:
            uids = data[0].split()
    except (imaplib.IMAP4.error, AttributeError):
        pass
        
    if not uids:
        return None

    # FIX: Filter out seen UIDs instead of skipping inside the loop
    new_uids = [u for u in uids if int(u) > since_uid]
    if not new_uids:
        return None

    best_result = None
    newest_uid_seen = since_uid

    # FIX: Walk ALL new UIDs (newest to oldest) to find the best code, instead of returning on the first email.
    for uid in reversed(new_uids):
        uid_int = int(uid)
        newest_uid_seen = max(newest_uid_seen, uid_int)
        try:
            typ, data = con.uid('FETCH', uid, "(BODY.PEEK[HEADER])")
            if typ != "OK":
                continue
            head = email.message_from_bytes(data[0][1])
            sender = head.get("From", "")
            subject = head.get("Subject", "") or ""

            if known_senders_only and not is_known_sender(sender):
                continue

            date = parsedate_to_datetime(head.get("Date", ""))
            if date is None:
                continue
            if date.tzinfo is None:
                date = date.replace(tzinfo=datetime.timezone.utc)
            age = now - date.astimezone(datetime.timezone.utc)
            if age > window:
                continue

            typ, data = con.uid('FETCH', uid, "(BODY.PEEK[])")
            if typ != "OK":
                continue
            msg = email.message_from_bytes(data[0][1])
            body = get_plain(msg)

            result = extract_code(body, subject, sender)
            events = extract_datetime(body, subject, sender) if DATEUTIL_AVAILABLE else []

            candidate = {
                "code": result["code"] if result else None,
                "confidence": result["confidence"] if result else 0,
                "method": result["method"] if result else None,
                "sender": sender,
                "subject": subject,
                "age": age,
                "uid": uid,
                "events": events,
                "body": body,
                "max_uid_seen": newest_uid_seen
            }

            # Return immediately if we find a code (since we are newest -> oldest)
            if result and result.get("code"):
                return candidate
                
            # Fallback if no code is found, keep track of the newest email to process events/subs
            if best_result is None:
                best_result = candidate
        except (imaplib.IMAP4.error, ssl.SSLError, socket.error, OSError, IndexError):
            continue

    if best_result is None:
        # Advance last_uid even if we couldn't fetch anything, to prevent infinite loops
        return {"uid": str(newest_uid_seen), "max_uid_seen": newest_uid_seen, "code": None,
                "confidence": 0, "method": None, "sender": "", "subject": "", "age": None,
                "events": [], "body": ""}
    return best_result


def supports_idle(con):
    try:
        typ, data = con.capability()
        caps = data[0].decode() if isinstance(data[0], bytes) else data[0]
        return "IDLE" in caps.upper()
    except Exception:
        return False


