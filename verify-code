def _which(name):
    """Cross-platform: find an executable in PATH."""
    if IS_WINDOWS:
        cmd = ["where", name]
    else:
        cmd = ["which", name]
    try:
        return subprocess.run(cmd, capture_output=True, timeout=5).returncode == 0
    except Exception:
        return False

def _chmod_600(path):
    if not IS_WINDOWS:
        os.chmod(path, 0o600)

def _chmod_644(path):
    if not IS_WINDOWS:
