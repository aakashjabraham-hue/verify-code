def main():
    p = argparse.ArgumentParser(
        description=f"verify-code v{__version__} — Copy codes, find events, track subscriptions.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
Examples:
  verify-code setup              # Interactive wizard (fun! 🎉)
  verify-code                    # One-shot: copy latest code
  verify-code scan               # Scan inbox for events
  verify-code scan --subscriptions  # Scan for subscriptions
  verify-code daemon             # Background: watch, copy, calendar
  verify-code daemon --subscriptions  # Daemon + subscription tracking
  verify-code daemon --no-idle   # Force polling
  verify-code subscriptions      # View tracked subscriptions
  verify-code dashboard          # Launch web dashboard in browser
  verify-code install            # Install to ~/.local/bin + systemd service
  verify-code update             # Download the latest version from GitHub
  verify-code uninstall          # Remove everything (script, config, data)
  verify-code auth               # (Re-)auth Google Calendar
  verify-code version            # Show version
  verify-code --version          # Show version (alternative)
  verify-code history            # Show last 10 copied codes
  verify-code daemon --secure --secure-timeout 15  # Daemon with auto-erase

One-liner install (Linux/macOS):
  curl -fL https://raw.githubusercontent.com/
    aakashjabraham-hue/verify-code/main/verify-code \\
    -o ~/.local/bin/verify-code && chmod +x ~/.local/bin/verify-code

One-liner install (Windows PowerShell):
  powershell -Command "iwr -Uri 'https://raw.githubusercontent.com/aakashjabraham-hue/verify-code/main/verify-code' -OutFile \"$env:APPDATA/verify-code/verify-code.py\"; python \"$env:APPDATA/verify-code/verify-code.py\" install"
"""
    )
    p.add_argument("cmd", nargs="?", default="run",
                   choices=["run", "setup", "daemon", "install", "uninstall", "update", "scan", "auth", "version", "history", "subscriptions", "dashboard"],
                   help="run (default) | setup | daemon | install | uninstall | update | scan | auth | version | history | subscriptions | dashboard")
    p.add_argument("--minutes", type=int, default=10,
                   help="lookback window in minutes (default 10)")
    p.add_argument("--interval", type=int, default=15,
                   help="daemon poll/IDLE timeout in seconds (default 15)")
    p.add_argument("--known-senders", action="store_true",
                   help="only extract from known verification senders")
    p.add_argument("--no-idle", action="store_true",
                   help="disable IMAP IDLE, force polling")
    p.add_argument("--dry-run", action="store_true",
                   help="show what would be done; no clipboard or calendar action")
    p.add_argument("--calendar", action="store_true",
                   help="enable Google Calendar integration")
    p.add_argument("--cal-threshold", type=int, default=50,
                   help="minimum confidence threshold for calendar events (default 50)")
    p.add_argument("--secure", action="store_true",
                   help="enable secure mode (auto-erase clipboard after timeout)")
    p.add_argument("--secure-timeout", type=int, default=0,
                   help="seconds before auto-erasing clipboard in secure mode (default: from config)")
    p.add_argument("--subscriptions", action="store_true",
                   help="enable subscription tracking (detect plans, renewals, trials)")
    p.add_argument("--warn-days", type=int, default=3,
                   help="days before renewal/trial-end to warn (default: 3)")
    p.add_argument("--script-path", default=sys.argv[0],
                   help="path to this script (for install; auto-detected)")
    p.add_argument("--version", action="version", version=f"verify-code v{__version__}")

    args = p.parse_args()

    if args.cmd == "setup":
        setup()
    elif args.cmd == "daemon":
        daemon_run(args)
    elif args.cmd == "install":
        # If running from piped stdin (curl | python3 - install), do self-install
        if sys.argv[0] in ("-", "/dev/stdin"):
            self_install()
        else:
            install_service(args)
    elif args.cmd == "uninstall":
        uninstall()
    elif args.cmd == "scan":
        scan_mode(args)
    elif args.cmd == "update":
        update_self()
    elif args.cmd == "auth":
        if calendar_auth_flow():
            print(c("  ✅  Calendar authorization complete!", Style.GREEN, Style.BOLD))
    elif args.cmd == "version":
        print(c(f"  verify-code v{__version__}", Style.GREEN, Style.BOLD))
    elif args.cmd == "history":
        history_cmd()
    elif args.cmd == "subscriptions":
        subscriptions_cmd(args)
    elif args.cmd == "dashboard":
        dashboard_cmd(args)
    else:
        run(args)


if __name__ == "__main__":
    main()
