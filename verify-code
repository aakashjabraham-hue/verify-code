def add_event_to_calendar(event):
    """Add an event to Google Calendar. Returns True on success."""
    service = get_calendar_service()
    if not service:
        return False

    try:
        # FIX: Use local system timezone instead of hardcoded America/Chicago
        local_tz = datetime.datetime.now().astimezone().tzinfo
        
        start_iso = event["start"]
        if "+" not in start_iso and "Z" not in start_iso:
            start_dt = datetime.datetime.fromisoformat(start_iso).replace(tzinfo=local_tz)
            start_iso = start_dt.isoformat()
            
        end_iso = event["end"]
        if "+" not in end_iso and "Z" not in end_iso:
            end_dt = datetime.datetime.fromisoformat(end_iso).replace(tzinfo=local_tz)
            end_iso = end_dt.isoformat()

        event_body = {
            "summary": event["title"],
            "start": {"dateTime": start_iso},
            "end": {"dateTime": end_iso},
        }
        if event.get("location"):
            event_body["location"] = event["location"]
        if event.get("description"):
            event_body["description"] = event["description"]

        created = service.events().insert(calendarId="primary", body=event_body).execute()
        return created.get("htmlLink")
    except Exception as e:
        print(c(f"  ✗  Calendar error: {e}", Style.RED), file=sys.stderr)
        return None


