# Google Calendar Integration
# ═══════════════════════════════════════════════════════════════════════

CAL_SCOPES = ["https://www.googleapis.com/auth/calendar.events"]

def get_calendar_service():
    """Get an authenticated Google Calendar service."""
    if not GOOGLE_AVAILABLE:
        return None

    creds = None
    if os.path.exists(CAL_TOKEN_FILE):
        try:
            with open(CAL_TOKEN_FILE) as f:
                token_data = json.load(f)
            creds = GoogleCreds.from_authorized_user_info(token_data, CAL_SCOPES)
        except Exception:
            pass

    # If no valid credentials, try to refresh
    if creds and creds.expired and creds.refresh_token:
        try:
            creds.refresh(GoogleRequest())
            # Save refreshed token
            with open(CAL_TOKEN_FILE, "w") as f:
                f.write(creds.to_json())
            os.chmod(CAL_TOKEN_FILE, 0o600)
        except Exception:
            return None

    if creds and creds.valid:
        try:
            service = build("calendar", "v3", credentials=creds)
            return service
        except Exception:
            return None

    return None


def calendar_auth_flow():
    """Run the interactive Google Calendar OAuth flow."""
    if not GOOGLE_AVAILABLE:
        print(c("  ✗  Google Calendar support requires:", Style.RED))
        print("     pip install google-auth-oauthlib google-api-python-client")
        print("     pip install python-dateutil")
        return False

    print()
    print(c("  ── 📅  Google Calendar Setup  ──", Style.CYAN, Style.BOLD))
    print()
    print("  To add events to your calendar, I need permission.")
    print("  You'll need a Google Cloud OAuth client.")
    print()
    print(c("  Step 1: Create OAuth credentials", Style.YELLOW, Style.BOLD))
    print("  Go to: https://console.cloud.google.com/apis/credentials")
    print("  → Create Credentials → OAuth 2.0 Client ID")
    print("  → Application type: Desktop app")
    print("  → Download the JSON file")
    print()
    print("  (Make sure you've enabled the Google Calendar API")
    print("   at https://console.cloud.google.com/apis/library)")
    print()

    json_path = input(c("  Path to client_secret JSON: ", Style.BOLD)).strip()
    json_path = os.path.expanduser(json_path)

    if not os.path.exists(json_path):
        print(c(f"  ✗  File not found: {json_path}", Style.RED))
        return False

    try:
        with open(json_path) as f:
            client_config = json.load(f)
    except Exception as e:
        print(c(f"  ✗  Could not read file: {e}", Style.RED))
        return False

    print()
    print(c("  Step 2: Authorize in your browser", Style.YELLOW, Style.BOLD))
    print("  A browser window will open. Sign in and grant access.")
    print()

    try:
        flow = InstalledAppFlow.from_client_config(
            client_config, CAL_SCOPES,
            redirect_uri="http://localhost:8080/"
        )

        # Start a local server to catch the redirect
        creds = flow.run_local_server(
            port=8080,
            host="localhost",
            open_browser=True,
            success_message="✅ verify-code is now authorized! You can close this tab.",
        )

        # Save token
        token_data = json.loads(creds.to_json())
        with open(CAL_TOKEN_FILE, "w") as f:
            json.dump(token_data, f, indent=2)
        os.chmod(CAL_TOKEN_FILE, 0o600)

        # Save client config for re-auth
        with open(CAL_CLIENT_FILE, "w") as f:
            json.dump(client_config, f, indent=2)
        os.chmod(CAL_CLIENT_FILE, 0o600)

        print()
        print(c("  ✅  Google Calendar authorized! Events can now be added.", Style.GREEN, Style.BOLD))
        return True

    except Exception as e:
        print(c(f"  ✗  Authorization failed: {e}", Style.RED))
        print("  Tip: Make sure your OAuth client is a 'Desktop app' type")
        print("  and the Calendar API is enabled in your Google Cloud project.")
        return False


def add_event_to_calendar(event):
    """Add an event to Google Calendar. Returns True on success."""
    service = get_calendar_service()
    if not service:
        return False

    try:
        event_body = {
            "summary": event["title"],
            "start": {"dateTime": event["start"], "timeZone": "America/Chicago"},
            "end": {"dateTime": event["end"], "timeZone": "America/Chicago"},
        }
        if event.get("location"):
            event_body["location"] = event["location"]
        if event.get("description"):
            event_body["description"] = event["description"]

        created = service.events().insert(calendarId="primary", body=event_body).execute()
        return created.get("htmlLink")
    except Exception as e:
        print(c(f"  ✗  Calendar error: {e}", Style.RED), file=sys.stderr)
        return None


