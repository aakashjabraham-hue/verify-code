# Subscription keywords in email subject/body
SUBSCRIPTION_KEYWORDS = re.compile(
    r"(?:subscription|subscribed|subscribing|renewal|renewed|renewing|renew|"
    r"trial|free trial|trial period|trial ends|trial ending|"
    r"billing|bill|invoice|receipt|payment|charged|charge|"
    r"upgrade|downgrade|plan change|cancel|cancelled|cancellation|"
    r"automatic payment|auto-renew|auto[- ]?renew|"
    r"your plan|your membership|your account|"
    r"next payment|payment due|due date|"
    r"thank you for your (?:purchase|order|payment))",
    re.I,
)

# Regex to extract dollar amounts
RE_AMOUNT = re.compile(r"\$(\d{1,6}(?:[.,]\d{2})?)")

# Regex to extract billing cycles
RE_BILLING_CYCLE = re.compile(
    r"(?:billed|billing|charge|charged|renews|renewal|every|each|per|[/])\s*"
    r"(monthly|month|yearly|annual|year|weekly|week|quarterly|quarter)",
    re.I,
)

# Regex to extract plan names
RE_PLAN_NAME = re.compile(
    r"(?:plan|tier|level|package|subscription)\s*:?\s*"
    r"([A-Za-z0-9][A-Za-z0-9\s.'\-+]{1,20}?)(?:\s*\$|\s*[.!,]|\s*$|"
    r"\s+(?:plan|subscription|tier|level)\b)",
    re.I,
)

# Regex to find dates near subscription keywords
RE_SUB_DATE = re.compile(
    r"(?:on|by|before|after|for|date:|\\.)?\s*"
    r"((?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|"
    r"Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
    r"\s+\d{1,2}(?:st|nd|rd|th)?(?:,?\s*\d{4})?)",
    re.I,
)

# Simple date like "2026-08-20" or "8/20/2026" near sub keywords
RE_SUB_DATE_ISO = re.compile(r"(\d{4}[-/]\d{1,2}[-/]\d{1,2})")
RE_SUB_DATE_US = re.compile(r"(\d{1,2}[-/]\d{1,2}[-/]\d{4})")


def _lookup_service_name(sender: str) -> str | None:
    """Look up the friendly service name from a sender email domain."""
    domain = _sender_domain(sender)
    if domain in SUBSCRIPTION_SENDERS:
        return SUBSCRIPTION_SENDERS[domain]
    # Try subdomain stripping
    parts = domain.split(".")
    for i in range(len(parts) - 1):
        candidate = ".".join(parts[i:])
        if candidate in SUBSCRIPTION_SENDERS:
            return SUBSCRIPTION_SENDERS[candidate]
    return None


def extract_subscription(text, subject="", sender="") -> dict | None:
    """Extract subscription info from an email body.

    Returns a dict with:
      - service: str (friendly name)
      - plan: str or None
      - amount: str or None (e.g. "$14.99")
      - billing_cycle: str or None (monthly/yearly/weekly)
      - next_billing: str or None (ISO date)
      - trial_end: str or None (ISO date)
      - status: str (active/trial/cancelled)
      - confidence: 0-100
      - source: str
      - sender: str
      - subject: str
    Returns None if no subscription info detected.
    """
    body = text[:5000]
    combined = f"{subject} {sender} {body}"

    # Quick check: does this look subscription-related at all?
    if not SUBSCRIPTION_KEYWORDS.search(combined):
        return None

    service_name = _lookup_service_name(sender)
    known_sender = service_name is not None

    body_lower = body.lower() + " " + subject.lower()

    # ── Detect status ──
    status = "active"
    if re.search(r"(?:trial|free trial|trial period|trial ends|trial ending)", combined, re.I):
        status = "trial"
    if re.search(r"(?:cancelled|canceled|cancelling|canceling|cancellation|"
                 r"cancel your|you cancelled|has been cancelled)", combined, re.I):
        status = "cancelled"

    # ── Extract amount ──
    amount = None
    amt_matches = RE_AMOUNT.findall(body)
    if amt_matches:
        amount = f"${amt_matches[0]}"

    # ── Extract billing cycle ──
    billing_cycle = None
    bc_m = RE_BILLING_CYCLE.search(body)
    if bc_m:
        raw = bc_m.group(1).lower()
        if raw in ("month", "monthly"):
            billing_cycle = "monthly"
        elif raw in ("year", "yearly", "annual"):
            billing_cycle = "yearly"
        elif raw in ("week", "weekly"):
            billing_cycle = "weekly"
        elif raw == "quarterly":
            billing_cycle = "quarterly"

    # ── Extract plan name ──
    plan = None
    # Pattern 1: "plan: [name]" or "plan [name]"
    plan_m = RE_PLAN_NAME.search(body)
    if plan_m:
        candidate = plan_m.group(1).strip()
        # Filter out false positives (too long, looks like a sentence fragment)
        if len(candidate) < 30 and not re.search(r"(?:will|your|this|that|has|have|been|with|for|the|and|our|we|you|to|is|are|was|on|at|it|in)", candidate, re.I):
            plan = candidate
    # Pattern 2: "the [Name] plan" or "your [Name] plan" or "[Name] Plan"
    if plan is None:
        plan_m2 = re.search(
            r"(?:the|your|our|this)\s+([A-Za-z][A-Za-z0-9\s.'\-+]{1,20}?)\s+"
            r"(?:plan|tier|level|package|subscription)\b",
            body, re.I
        )
        if plan_m2:
            candidate = plan_m2.group(1).strip()
            if len(candidate) < 30:
                plan = candidate

    # ── Extract dates ──
    next_billing = None
    trial_end = None

    if DATEUTIL_AVAILABLE:
        now = datetime.datetime.now()

        # Look for explicit dates near subscription keywords
        for m in RE_SUB_DATE.finditer(body):
            try:
                dt = dateparser.parse(m.group(1), fuzzy=False, default=now)
                if dt and dt > datetime.datetime(2000, 1, 1):
                    iso = dt.strftime("%Y-%m-%d")
                    # Check context: is this a trial end or next billing?
                    ctx = body[max(0, m.start() - 60):m.end() + 60].lower()
                    if re.search(r"(?:trial ends|trial ending|trial period ends|"
                                 r"free trial ends|trial expires)", ctx):
                        trial_end = iso
                    elif status == "trial":
                        trial_end = iso
                    else:
                        next_billing = iso
            except (ValueError, TypeError):
                pass

        # ISO dates
        for m in RE_SUB_DATE_ISO.finditer(body):
            try:
                dt = dateparser.parse(m.group(1), fuzzy=False)
                if dt and dt > datetime.datetime(2000, 1, 1):
                    if trial_end is None:
                        ctx = body[max(0, m.start() - 60):m.end() + 60].lower()
                        if re.search(r"(?:trial|free)", ctx):
                            trial_end = dt.strftime("%Y-%m-%d")
                    if next_billing is None:
                        next_billing = dt.strftime("%Y-%m-%d")
            except (ValueError, TypeError):
                pass

        # US dates
        for m in RE_SUB_DATE_US.finditer(body):
            try:
                parts = m.group(1).replace("-", "/").split("/")
                parts = [int(p) for p in parts]
                if 1 <= parts[0] <= 12 and 1 <= parts[1] <= 31 and parts[2] >= 2020:
                    dt = datetime.datetime(parts[2], parts[0], parts[1])
                    if trial_end is None:
                        ctx = body[max(0, m.start() - 60):m.end() + 60].lower()
                        if re.search(r"(?:trial|free)", ctx):
                            trial_end = dt.strftime("%Y-%m-%d")
                    if next_billing is None:
                        next_billing = dt.strftime("%Y-%m-%d")
            except (ValueError, TypeError):
                pass

        # If nothing found, try fuzzy date parsing
        if next_billing is None and trial_end is None:
            # Look for "renews on [date]" or "will be charged on [date]"
            for pat in [
                re.compile(r"(?:renews|will renew|next renewal|next billing)[:\s]+"
                           r"((?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|"
                           r"Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
                           r"\s+\d{1,2}(?:st|nd|rd|th)?,?\s*\d{4})", re.I),
                re.compile(r"(?:charged|payment|billed)[:\s]+(?:on|the)\s+"
                           r"((?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|"
                           r"Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
                           r"\s+\d{1,2}(?:st|nd|rd|th)?,?\s*\d{4})", re.I),
            ]:
                m = pat.search(body)
                if m:
                    try:
                        dt = dateparser.parse(m.group(1), fuzzy=False, default=now)
                        if dt and dt > datetime.datetime(2000, 1, 1):
                            next_billing = dt.strftime("%Y-%m-%d")
                            break
                    except (ValueError, TypeError):
                        pass

    # ── Compute confidence ──
    confidence = 0
    signals = 0

    if known_sender:
        confidence += 30
        signals += 1
    if amount:
        confidence += 20
        signals += 1
    if billing_cycle:
        confidence += 15
        signals += 1
    if next_billing or trial_end:
        confidence += 20
        signals += 1
    if plan:
        confidence += 10
        signals += 1
    if status == "trial":
        confidence += 5  # trial status is a strong signal

    if not known_sender and not amount:
        # Generic subscription email, low confidence
        confidence = max(confidence, 15)

    if confidence < 20:
        return None

    confidence = min(confidence, 98)

    # ── Build result ──
    # If no known service, try to guess from subject
    if service_name is None:
        # Try to extract a service name from the sender domain
        domain = _sender_domain(sender)
        # Clean up common prefixes
        service_name = domain.replace("mail.", "").replace("message.", "") \
            .replace("noreply.", "").replace("accounts.", "") \
            .replace("account.", "").replace("e.", "") \
            .split(".")[0].title()

    result = {
        "service": service_name or "Unknown",
        "plan": plan,
        "amount": amount,
        "billing_cycle": billing_cycle,
        "next_billing": next_billing,
        "trial_end": trial_end,
        "status": status,
        "confidence": confidence,
        "source": "email",
        "sender": sender,
        "subject": subject,
    }
    return result


def format_subscription(sub, warn=False) -> str:
    """Format a subscription dict into a human-readable line."""
    parts = [c(sub["service"], Style.BOLD, Style.CYAN) if not warn else c(sub["service"], Style.BOLD, Style.YELLOW)]
    if sub["plan"]:
        parts.append(f"({sub['plan']})")
    if sub["amount"]:
        parts.append(sub["amount"])
    if sub["billing_cycle"]:
        parts.append(f"/{sub['billing_cycle']}")
    if sub["next_billing"]:
        parts.append(f"→ renews {sub['next_billing']}")
    if sub["trial_end"]:
        parts.append(c(f"⚠ trial ends {sub['trial_end']}", Style.YELLOW) if warn else f"trial ends {sub['trial_end']}")
    if sub["status"] == "cancelled":
        parts.append(c("❌ cancelled", Style.RED, Style.BOLD))
    # Confidence bar
    conf_bar = "█" * (sub["confidence"] // 10) + "░" * (10 - sub["confidence"] // 10)
    parts.append(c(f"({conf_bar} {sub['confidence']}%)", Style.DIM))
    return "  ".join(parts)


def check_subscription_warnings(subscriptions: list[dict], warn_days: int = 3) -> list[dict]:
    """Check which subscriptions need warnings (about to renew or trial ending)."""
    now = datetime.datetime.now().date()
    warnings = []
    for sub in subscriptions:
        if sub.get("next_billing"):
            try:
                renew_date = datetime.datetime.strptime(sub["next_billing"], "%Y-%m-%d").date()
                days_until = (renew_date - now).days
                if 0 <= days_until <= warn_days:
                    warnings.append({**sub, "warn_type": "renewal", "days_until": days_until})
            except ValueError:
                pass
        if sub.get("trial_end"):
            try:
                trial_date = datetime.datetime.strptime(sub["trial_end"], "%Y-%m-%d").date()
                days_until = (trial_date - now).days
                if 0 <= days_until <= warn_days:
                    warnings.append({**sub, "warn_type": "trial_end", "days_until": days_until})
            except ValueError:
                pass
    return warnings


