def download_latest():
    """Download the latest verify-code from GitHub to the install path.
    Returns the version string on success, None on failure."""
    if IS_WINDOWS:
        local_bin = os.path.join(os.environ.get("APPDATA", os.path.expanduser("~")), "verify-code")
        local_script = os.path.join(local_bin, "verify-code.py")
    else:
        local_bin = os.path.expanduser("~/.local/bin")
        local_script = os.path.join(local_bin, "verify-code")
    os.makedirs(local_bin, exist_ok=True)

    # ── Check curl / PowerShell ──
    if not _which("curl") and not IS_WINDOWS:
        print(c("  ✗  curl is required. Install it: sudo apt install curl", Style.RED))
        return None

    # ── Download with progress bar ──
    cache_buster = f"?v={int(time.time())}"
    url = "https://raw.githubusercontent.com/aakashjabraham-hue/verify-code/main/verify-code" + cache_buster
    print(c("  🌐  Downloading from GitHub…", Style.BOLD))
    print()
    if IS_WINDOWS:
        result = subprocess.run(
            ["powershell", "-Command",
             f"Invoke-WebRequest -Uri '{url}' -OutFile '{local_script}' -UseBasicParsing"],
            capture_output=False, timeout=60
        )
    else:
        result = subprocess.run(
            ["curl", "-#", "-fL", "-H", "Cache-Control: no-cache", "-o", local_script, url],
            capture_output=False, timeout=60
        )
    if result.returncode != 0:
        print()
        print(c("  ✗  Download failed. Check your internet connection.", Style.RED))
        return None

    _chmod_755(local_script)
    print()

    # ── Read version ──
    version_str = "?"
    try:
        for line in open(local_script):
            if line.startswith("__version__"):
                version_str = line.split('"')[1]
                break
    except Exception:
        pass

    print(c(f"  ✅  Downloaded version {version_str} to {local_script}", Style.GREEN, Style.BOLD))
    print()

    return version_str


