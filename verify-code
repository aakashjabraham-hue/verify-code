def update_self():
    """Update verify-code to the latest version from GitHub."""
    print()
    print(c("  ╔══════════════════════════════════════════╗", Style.CYAN, Style.BOLD))
    print(c("  ║   🔄  Checking for updates…              ║", Style.CYAN, Style.BOLD))
    print(c("  ╚══════════════════════════════════════════╝", Style.CYAN, Style.BOLD))
    print()

    # Check for curl / PowerShell
    if not _which("curl") and not IS_WINDOWS:
        print(c("  ✗  curl is required for updates.", Style.RED))
        print("  Install it: sudo apt install curl")
        return

    current_version = __version__

    # Download to a temp file first to check the version
    cache_buster = f"?v={int(time.time())}"
    url = "https://raw.githubusercontent.com/aakashjabraham-hue/verify-code/main/verify-code" + cache_buster
    if IS_WINDOWS:
        local_script = os.path.join(os.environ.get("APPDATA", os.path.expanduser("~")), "verify-code", "verify-code.py")
        local_bin = os.path.dirname(local_script)
    else:
        local_script = os.path.expanduser("~/.local/bin/verify-code")
        local_bin = os.path.expanduser("~/.local/bin")
    os.makedirs(local_bin, exist_ok=True)
    tmp_script = local_script + ".tmp"

    try:
        if IS_WINDOWS:
            result = subprocess.run(
                ["powershell", "-Command",
                 f"Invoke-WebRequest -Uri '{url}' -OutFile '{tmp_script}' -UseBasicParsing"],
                capture_output=False, timeout=60
            )
        else:
            result = subprocess.run(
                ["curl", "-#", "-fL", "-H", "Cache-Control: no-cache", "-o", tmp_script, url],
                capture_output=False, timeout=60
            )
        if result.returncode != 0:
            print(c(" ✗", Style.RED))
            print(c("  ✗  Download failed (curl error)", Style.RED))
            print()
            for p in [tmp_script]:
                try:
                    os.remove(p)
                except Exception:
                    pass
            return

        # Read the new version
        remote_version = "?"
        try:
            for line in open(tmp_script):
                if line.startswith("__version__"):
                    remote_version = line.split('"')[1]
                    break
        except Exception:
            pass

        if remote_version == current_version or remote_version == "?":
            os.remove(tmp_script)
            print(c(f"  ✅  You're already on the latest version ({current_version})!", Style.GREEN, Style.BOLD))
            print()
            return

        # Install the new version
        os.replace(tmp_script, local_script)
        _chmod_755(local_script)
        print(c(f"  ✅  Updated from {current_version} → {remote_version}!", Style.GREEN, Style.BOLD))
        print(f"  Saved to: {local_script}")
        print()
        print("  Run any command to use the new version. 🚀")

    except subprocess.TimeoutExpired:
        print(c(" ✗", Style.RED))
        print(c("  ✗  Download timed out. Check your internet connection.", Style.RED))
        for p in [tmp_script]:
            try:
                os.remove(p)
            except Exception:
                pass
    except Exception as e:
        print(c(" ✗", Style.RED))
        print(c(f"  ✗  Update failed: {e}", Style.RED))
        for p in [tmp_script]:
            try:
                os.remove(p)
            except Exception:
                pass


