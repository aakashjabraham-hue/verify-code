def _compute_crc(data: dict) -> str:
    raw = json.dumps(data, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(raw).hexdigest()[:12]


def load_state():
    default = {"last_uid": 0, "seen_codes": [], "seen_events": [], "seen_subscriptions": [], "last_time": None}
    try:
        with open(STATE_FILE) as f:
            data = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return default
    stored_crc = data.pop("_crc", None)
    if stored_crc is None:
        return default
    computed = _compute_crc(data)
    if stored_crc != computed:
        print(c("⚠  State file corrupted (CRC mismatch); resetting.", Style.YELLOW), file=sys.stderr)
        return default
    if "seen_subscriptions" not in data:
        data["seen_subscriptions"] = []
    for k in ("last_uid", "seen_codes", "last_time"):
        if k not in data:
            return default
    if "seen_events" not in data:
        data["seen_events"] = []
    return data


def save_state(state):
    os.makedirs(STATE_DIR, exist_ok=True)
    payload = {k: v for k, v in state.items()
               if k in ("last_uid", "seen_codes", "seen_events", "seen_subscriptions", "last_time")}
    payload["_crc"] = _compute_crc(payload)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(payload, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, STATE_FILE)
    _chmod_600(STATE_FILE)


def log_event(sender, subject, code=None, event=None):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        with open(LOG_FILE, "a") as f:
            if code:
                f.write(f"[{ts}] CODE sender={sender} subject={subject!r} code={code}\n")
            if event:
                f.write(f"[{ts}] EVENT sender={sender} subject={subject!r} event={event}\n")
        _chmod_600(LOG_FILE)
    except Exception:
        pass


def _subscription_key(sub: dict) -> str:
    service = sub.get("service", "unknown")
    plan = sub.get("plan", "")
    amount = sub.get("amount", "")
    return f"{service}:{plan}:{amount}"


def load_subscriptions() -> list[dict]:
    try:
        with open(SUBSCRIPTIONS_FILE) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return []


def save_subscription(sub: dict):
    subs = load_subscriptions()
    key = _subscription_key(sub)
    existing = False
    for i, s in enumerate(subs):
        if _subscription_key(s) == key:
            subs[i] = {**s, **sub}
            if s.get("next_billing") and sub.get("next_billing"):
                subs[i]["next_billing"] = min(s["next_billing"], sub["next_billing"])
            existing = True
            break
    if not existing:
        subs.append(sub)
    subs = subs[-200:]
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(SUBSCRIPTIONS_FILE, "w") as f:
            json.dump(subs, f, indent=2)
        _chmod_600(SUBSCRIPTIONS_FILE)
    except Exception:
        pass


