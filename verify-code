def run(args):
    """One-shot mode: find and copy the newest code."""
    creds = load_creds()
    window = datetime.timedelta(minutes=args.minutes)
    con = connect(creds)
    try:
        res = find_newest_code(con, window, since_uid=0,
                               known_senders_only=args.known_senders)
    finally:
        try:
            con.close()
        except Exception:
            pass
        con.logout()

    if not res:
        print(f"No verification code found in the last {args.minutes} minutes.")
        if args.known_senders:
            print("Tip: remove --known-senders to check all senders (higher FP risk).")
        else:
            print("Tip: run right after the email arrives, or bump --minutes.")
        return

    if args.dry_run:
        print(f"[dry-run] Would copy code from: {res['sender']}")
        print(f"  Subject:    {res['subject']!r}")
        if res["code"]:
            print(f"  Code:       {res['code']}  (confidence: {res['confidence']}%, method: {res['method']})")
        else:
            print("  Code:       (none found)")
        if res["events"]:
            for ev in res["events"]:
                print(f"  Event:      {ev['title']} @ {ev['start']}  (confidence: {ev['confidence']}%)")
        print(f"  Age:        {res['age']}")
        return

    if res["code"]:
        backend = copy_clipboard(res["code"])
        log_event(res["sender"], res["subject"], code=res["code"])
        print(c(f"  📋  Copied verification code to clipboard ({backend}).", Style.GREEN, Style.BOLD))
        print(f"  From:    {res['sender']}")
        print(f"  Subject: {res['subject']}")
        print(c(f"  Code:    {res['code']}", Style.CYAN, Style.BOLD))
        print(f"  Confidence: {res['confidence']}%  ({res['method']})")
        print()

    # Handle events
    if res["events"] and args.calendar and not args.dry_run:
        calendar_service = get_calendar_service()
        if calendar_service:
            for ev in res["events"]:
                if ev["confidence"] >= args.cal_threshold:
                    link = add_event_to_calendar(ev)
                    if link:
                        log_event(res["sender"], res["subject"], event=ev["title"])
                        print(c(f"  📅  Added to calendar: {ev['title']}", Style.GREEN))
                        print(f"  When: {ev['start']} → {ev['end']}")
                        if ev.get("location"):
                            print(f"  Where: {ev['location']}")
        else:
            if res["events"]:
                print(c("  ⚠  Calendar not authorized. Run: verify-code auth", Style.YELLOW))


def daemon_run(args):
    """Background daemon mode: watch inbox, auto-copy codes, extract events."""
    creds = load_creds()
    window = datetime.timedelta(minutes=args.minutes)
    state = load_state()
    last_uid = int(state.get("last_uid", 0))
    seen_codes = set(state.get("seen_codes", []))
    seen_events = set(state.get("seen_events", []))
    interval = args.interval

    have_calendar = bool(get_calendar_service())

    if not subprocess.run(["which", "wl-copy"], capture_output=True).returncode == 0:
        notify("verify-code", "wl-copy not found — install wl-clipboard for auto-copy.")
        print(c("WARNING: wl-copy missing; codes will be logged but not copied.", Style.YELLOW), file=sys.stderr)

    print(c(f"  🔐  verify-code daemon v{__version__} started", Style.CYAN, Style.BOLD))
    print(f"     Window: {args.minutes}m  |  Interval: {interval}s"
          f"  |  Known-senders: {'yes' if args.known_senders else 'no'}"
          f"  |  Calendar: {'yes' if have_calendar else 'no'}")
    if have_calendar:
        print(f"     Calendar min confidence: {args.cal_threshold}%")
    print(f"     Last UID: {last_uid}", flush=True)

    while True:
        try:
            con = connect(creds)
            has_idle = supports_idle(con) and not args.no_idle
            if has_idle:
                print(f"  [{datetime.datetime.now():%H:%M:%S}] {c('IMAP IDLE', Style.CYAN)} mode active.", flush=True)
            else:
                print(f"  [{datetime.datetime.now():%H:%M:%S}] {c('Polling', Style.DIM)} mode ({interval}s).", flush=True)

            while True:
                if has_idle:
                    res = wait_for_code_idle(con, window, since_uid=last_uid,
                                             known_senders_only=args.known_senders,
                                             idle_timeout=interval)
                else:
                    res = find_newest_code(con, window, since_uid=last_uid,
                                           known_senders_only=args.known_senders)
                    con.noop()
                    time.sleep(interval)

                if res:
                    now_ts = datetime.datetime.now().strftime("%H:%M:%S")

                    # ── Handle code ──
                    if res["code"]:
                        dedup_key = f"{_sender_domain(res['sender'])}:{_code_hash(res['code'])}"
                        if dedup_key in seen_codes:
                            print(f"  [{now_ts}] skipped duplicate {res['code']} from {res['sender']}", flush=True)
                            last_uid = max(last_uid, res["uid"])
                            continue

                        try:
                            copy_clipboard(res["code"])
                            log_event(res["sender"], res["subject"], code=res["code"])
                            notify("Verification code copied ✅",
                                   f"{res['code']}  —  {res['subject']}\nFrom: {res['sender']}")
                            print(c(f"  [{now_ts}] 📋 Copied {res['code']} from {res['sender']} "
                                  f"({res['confidence']}%)", Style.GREEN), flush=True)
                        except RuntimeError as e:
                            print(f"  [{now_ts}] clipboard error: {e}", file=sys.stderr, flush=True)
                            log_event(res["sender"], res["subject"], code=res["code"])

                        last_uid = res["uid"]
                        seen_codes.add(dedup_key)
                        if len(seen_codes) > 50:
                            seen_codes = set(list(seen_codes)[-50:])

                    # ── Handle events ──
                    if res["events"] and have_calendar:
                        for ev in res["events"]:
                            ev_key = f"{res['uid']}:{ev['start']}"
                            if ev_key in seen_events:
                                continue
                            if ev["confidence"] >= args.cal_threshold:
                                # Check if it's a real event (not just any date)
                                link = add_event_to_calendar(ev)
                                if link:
                                    seen_events.add(ev_key)
                                    log_event(res["sender"], res["subject"], event=ev["title"])
                                    msg = f"📅  {ev['title']} @ {ev['start'][:16]}"
                                    notify("Event added to calendar", msg)
                                    print(c(f"  [{now_ts}] {msg}", Style.CYAN), flush=True)
                                    # Keep seen_events bounded
                                    if len(seen_events) > 50:
                                        seen_events = set(list(seen_events)[-50:])

                    # Update state (even if only UID advanced)
                    last_uid = max(last_uid, res["uid"])
                    save_state({
                        "last_uid": last_uid,
                        "seen_codes": list(seen_codes),
                        "seen_events": list(seen_events),
                        "last_time": datetime.datetime.now().isoformat(),
                    })

        except (imaplib.IMAP4.error, ssl.SSLError, socket.error, OSError) as e:
            print(f"  [{datetime.datetime.now():%H:%M:%S}] connection error: {e}; retrying…",
                  file=sys.stderr, flush=True)
            time.sleep(max(interval, 10))
        except KeyboardInterrupt:
            print(c("\n  ⏹  Daemon stopped.", Style.YELLOW), flush=True)
            break


def scan_mode(args):
    """Scan inbox for events with dates/times (no code copy)."""
    creds = load_creds()
    window = datetime.timedelta(minutes=args.minutes)
    con = connect(creds)
    print(c(f"  🔍  Scanning inbox for events (last {args.minutes} min)...", Style.CYAN, Style.BOLD))
    print()

    try:
        res = find_newest_code(con, window, since_uid=0,
                               known_senders_only=args.known_senders)
    finally:
        try:
            con.close()
        except Exception:
            pass
        con.logout()

    if not res:
        print("  No emails found in the scan window.")
        return

    if res["code"]:
        print(c(f"  📋  Code found: {res['code']}", Style.GREEN, Style.BOLD))
        print(f"     From: {res['sender']}")
        print(f"     Subject: {res['subject']}")
        print(f"     Confidence: {res['confidence']}% ({res['method']})")
        print()

    if res["events"]:
        print(c(f"  📅  Events found: {len(res['events'])}", Style.CYAN, Style.BOLD))
        print()
        for i, ev in enumerate(res["events"], 1):
            conf_bar = "█" * (ev["confidence"] // 10) + "░" * (10 - ev["confidence"] // 10)
            print(f"  {i}. {c(ev['title'], Style.BOLD)}")
            print(f"     {c('When:', Style.DIM)} {ev['start'][:16]} → {ev['end'][:16]}")
            if ev.get("location"):
                print(f"     {c('Where:', Style.DIM)} {ev['location']}")
            print(f"     {c('Type:', Style.DIM)} {ev['event_type']}  "
                  f"|  {c('Confidence:', Style.DIM)} {conf_bar} {ev['confidence']}%")
            print()
    else:
        print("  No events with dates/times found.")
        print("  Tip: Try --minutes 60 to scan a wider window.")
        print()


def install_service(args):
    """Install the systemd user service."""
    os.makedirs(os.path.dirname(SERVICE_FILE), exist_ok=True)
    script_path = os.path.abspath(args.script_path)

    # Also copy to ~/.local/bin if not already there
    local_bin = os.path.expanduser("~/.local/bin")
    local_script = os.path.join(local_bin, "verify-code")
    if os.path.abspath(script_path) != os.path.abspath(local_script):
        os.makedirs(local_bin, exist_ok=True)
        with open(script_path) as f:
            content = f.read()
        with open(local_script, "w") as f:
            f.write(content)
        os.chmod(local_script, 0o755)
        print(c(f"  ✅  Copied to {local_script}", Style.GREEN))
        if local_bin not in os.environ.get("PATH", ""):
            print(c(f"  ⚠  Add {local_bin} to your PATH:", Style.YELLOW))
            print(f"     echo 'export PATH=\"$PATH:{local_bin}\"' >> ~/.bashrc")

    service_content = f"""\
[Unit]
Description=verify-code v{__version__} — auto-copy codes, find events
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={local_script} daemon --calendar
Restart=on-failure
RestartSec=10
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/$UID

[Install]
WantedBy=default.target
"""

    with open(SERVICE_FILE, "w") as f:
        f.write(service_content)
    os.chmod(SERVICE_FILE, 0o644)

    print(c(f"  ✅  Installed: {SERVICE_FILE}", Style.GREEN, Style.BOLD))
    print()
    print("  To enable and start:")
    print(c("    systemctl --user daemon-reload", Style.BOLD))
    print(c("    systemctl --user enable --now verify-code", Style.BOLD))
    print()
    print("  To check status:")
    print("    systemctl --user status verify-code")
    print()
    print("  To view logs:")
    print("    journalctl --user -u verify-code -f")


def uninstall():
    """Remove verify-code: script, credentials, state, systemd service, calendar token."""
    print_banner()
    print(c("  ╔══════════════════════════════════════════╗", Style.RED, Style.BOLD))
    print(c("  ║   ⚠  Uninstalling verify-code  ⚠        ║", Style.RED, Style.BOLD))
    print(c("  ╚══════════════════════════════════════════╝", Style.RED, Style.BOLD))
    print()
    print(c("  This will remove:", Style.BOLD))
    print(f"  •  Script:          ~/.local/bin/verify-code")
    print(f"  •  Config:          {CONFIG_DIR}")
    print(f"  •  Data:            {STATE_DIR}")
    print(f"  •  Systemd service: {SERVICE_FILE}")
    print(f"  •  Calendar token:  {CAL_TOKEN_FILE}")
    print()
    ans = input(c("  Are you sure? (type 'yes' to confirm): ", Style.RED, Style.BOLD)).strip().lower()
    if ans != "yes":
        print(c("  ✗  Uninstall cancelled.", Style.YELLOW))
        return

    removed = []
    errors = []

    # 1. Systemd service
    if os.path.exists(SERVICE_FILE):
        try:
            # Stop + disable first
            subprocess.run(["systemctl", "--user", "stop", "verify-code"],
                           capture_output=True, timeout=10)
            subprocess.run(["systemctl", "--user", "disable", "verify-code"],
                           capture_output=True, timeout=10)
            os.remove(SERVICE_FILE)
            removed.append(SERVICE_FILE)
        except Exception as e:
            errors.append(f"systemd: {e}")

    # 2. Script from ~/.local/bin
    local_script = os.path.expanduser("~/.local/bin/verify-code")
    if os.path.exists(local_script):
        try:
            os.remove(local_script)
            removed.append(local_script)
        except Exception as e:
            errors.append(f"script: {e}")

    # 3. Config directory
    if os.path.exists(CONFIG_DIR):
        import shutil
        try:
            shutil.rmtree(CONFIG_DIR)
            removed.append(f"{CONFIG_DIR}/")
        except Exception as e:
            errors.append(f"config: {e}")

    # 4. Data directory
    if os.path.exists(STATE_DIR):
        import shutil
        try:
            shutil.rmtree(STATE_DIR)
            removed.append(f"{STATE_DIR}/")
        except Exception as e:
            errors.append(f"data: {e}")

    print()
    for item in removed:
        print(c(f"  ✅  Removed: {item}", Style.GREEN))

    if errors:
        for err in errors:
            print(c(f"  ⚠  {err}", Style.YELLOW))
        print()
        print(c("  Some items need manual removal. Run as root if needed:", Style.YELLOW))
        print("    sudo rm -rf ~/.config/verify-code ~/.local/share/verify-code")
        print("    sudo systemctl --user disable verify-code 2>/dev/null")
        print("    sudo rm -f ~/.config/systemd/user/verify-code.service")
        print("    systemctl --user daemon-reload")

    print()
    print(c("  verify-code has been removed. 👋", Style.CYAN, Style.BOLD))


