    elif IS_MACOS:
        try:
            subprocess.run(["osascript", "-e",
                f'display notification {shlex.quote(body)} with title {shlex.quote(title)}'],
                capture_output=True, timeout=5)
        except Exception:
            pass
    else:
        try:
            subprocess.run(["notify-send", title, body], capture_output=True, timeout=5)
        except Exception:
            pass

# ── Clipboard Helpers ─────────────────────────────────────────────────────────

def copy_clipboard(text):
    text = text.strip()
    for cmd, backend in [
        (["powershell", "-Command", "$input | Set-Clipboard"], "windows"),
        (["wl-copy"], "wayland"),
        (["xclip", "-selection", "clipboard"], "x11"),
        (["pbcopy"], "macos"),
    ]:
        try:
            if cmd[0] == "powershell":
                if IS_WINDOWS:
                    res = subprocess.run(cmd, input=text.encode(), capture_output=True, timeout=5)
                    if res.returncode == 0:
                        return backend
                    continue
                else:
                    continue
            if _which(cmd[0]):
                res = subprocess.run(
                    cmd, 
                    input=text.encode(), 
                    stdout=subprocess.DEVNULL, 
                    stderr=subprocess.DEVNULL, 
                    timeout=5
                )
                if res.returncode == 0:
                    return backend
                continue
        except (subprocess.TimeoutExpired, OSError):
            continue
    raise RuntimeError("No clipboard tool worked (install wl-clipboard for Wayland, xclip for X11, or use Windows).")

def erase_clipboard():
    for cmd in [["powershell", "-Command", "$input | Set-Clipboard"], ["wl-copy"], ["xclip", "-selection", "clipboard"], ["pbcopy"]]:
        try:
            if cmd[0] == "powershell":
                if IS_WINDOWS:
                    subprocess.run(cmd, input=b" " * 20, capture_output=True, timeout=5)
                    return
                continue
            if _which(cmd[0]):
                subprocess.run(cmd, input=b" " * 20, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
                return
        except (subprocess.TimeoutExpired, OSError):
            continue

def secure_copy_clipboard(text, timeout=30):
    global _CLIPBOARD_GEN
    backend = copy_clipboard(text)
    if timeout > 0:
        _CLIPBOARD_GEN += 1
        my_gen = _CLIPBOARD_GEN
        
        def _erase():
            time.sleep(timeout)
            if my_gen == _CLIPBOARD_GEN:
                erase_clipboard()
                
        t = threading.Thread(target=_erase, daemon=True)
        t.start()
        atexit.register(erase_clipboard)
    return backend

def get_email_bodies(msg):
    if msg.is_multipart():
        plain = html_body = None
        for part in msg.walk():
            ct = part.get_content_type()
            if ct == "text/plain" and plain is None:
                try:
                    payload = part.get_payload(decode=True)
                    if payload:
                        charset = part.get_content_charset() or "utf-8"
                        try:
                            plain = payload.decode(charset, errors="replace")
                        except LookupError:
                            plain = payload.decode("utf-8", errors="replace")
                except Exception:
                    pass
            elif ct == "text/html" and html_body is None:
                try:
                    payload = part.get_payload(decode=True)
                    if payload:
                        charset = part.get_content_charset() or "utf-8"
                        try:
                            html_body = payload.decode(charset, errors="replace")
                        except LookupError:
                            html_body = payload.decode("utf-8", errors="replace")
                except Exception:
                    pass
        if plain:
            return plain, html_body
        if html_body:
            return html_to_text(html_body), html_body
        return "", None
    try:
        body = msg.get_payload(decode=True)
        if body is None:
            return "", None
        charset = msg.get_content_charset() or "utf-8"
        try:
            decoded = body.decode(charset, errors="replace")
        except LookupError:
            decoded = body.decode("utf-8", errors="replace")
        if msg.get_content_type() == "text/html":
            return html_to_text(decoded), decoded
        return decoded, None
    except Exception:
        return str(msg), None

def html_to_text(html_str):
    text = html_str
    text = re.sub(r"<style[^>]*>.*?</style>", " ", text, flags=re.S | re.I)
    text = re.sub(r"<script[^>]*>.*?</script>", " ", text, flags=re.S | re.I)
    text = re.sub(r"<!--.*?-->", " ", text, flags=re.S)
    text = re.sub(r"</?(?:div|p|br|tr|li|h[1-6]|blockquote|section|article|header|footer)[^>]*>", "\n", text, flags=re.I)
    text = re.sub(r"<[^>]+>", " ", text)
    text = html.unescape(text)
    text = re.sub(r"\n\s*\n", "\n", text)
    text = re.sub(r" +", " ", text)
    return text.strip()

# ── Magic Link Extraction ─────────────────────────────────────────────────────
RE_A_TAG = re.compile(r'<a\s[^>]*href=["\'](?P<url>[^"\']+)["\'][^>]*>(?P<text>.*?)</a>', re.I | re.S)
RE_LINK_BLACKLIST = re.compile(
    r"(?:unsubscribe|preferences|privacy|terms|facebook|twitter|linkedin|instagram|"
    r"youtube|mailto|tel:|#|apps\.apple|play\.google|"
    r"manage\snotifications|view\sin\sbrowser|download|app\sstore|google\splay|"
    r"contact\sus|support|help|faq|blog|newsletter|copyright|©)",
    re.I
)

def extract_magic_link(html_str, subject="", sender=""):
    if not html_str:
        return None
    known_sender = is_known_sender(sender)
    for m in RE_A_TAG.finditer(html_str):
        url = html.unescape(m.group("url").strip())
        text = re.sub(r'<[^>]+>', '', m.group("text")).strip()
        if not url.startswith("http"):
            continue
        has_context = bool(CONTEXT_WORDS.search(text) or CONTEXT_WORDS.search(url))
        is_blacklisted = bool(RE_LINK_BLACKLIST.search(text) or RE_LINK_BLACKLIST.search(url))
        if has_context and not is_blacklisted:
            if not known_sender:
                if not re.search(r"(?:verify|confirm|magic|authenticat|sign[\s-]?in|log[\s-]?in)", text, re.I):
                    continue
            return url
    return None

def _sender_domain(sender: str) -> str:
    m = re.search(r"@([^>\s]+)", sender)
    return m.group(1).lower().lstrip(".") if m else sender.lower()

def _code_hash(code: str) -> str:
    return hashlib.sha256(code.encode()).hexdigest()[:16]

def is_known_sender(sender: str) -> bool:
    domain = _sender_domain(sender)
    if domain in KNOWN_SENDERS:
        return True
    parts = domain.split(".")
    for i in range(len(parts) - 1):
        candidate = ".".join(parts[i:])
        if candidate in KNOWN_SENDERS:
            return True
    return False

