def copy_clipboard(text):
    text = text.strip().replace(" ", "").replace("-", "")
    for cmd, backend in [
        (["powershell", "-Command", "$input | Set-Clipboard"], "windows"),
        (["wl-copy"], "wayland"),
        (["xclip", "-selection", "clipboard"], "x11"),
        (["pbcopy"], "macos"),
    ]:
        try:
            if cmd[0] == "powershell":
                if IS_WINDOWS:
                    res = subprocess.run(cmd, input=text.encode(), capture_output=True, timeout=5)
                    if res.returncode == 0:
                        return backend
                    continue
                else:
                    continue
            if _which(cmd[0]):
                res = subprocess.run(cmd, input=text.encode(), capture_output=True, timeout=5)
                if res.returncode == 0:
                    return backend
                # Tool exists but failed (e.g. no Wayland socket) — try next backend
                continue
        except (subprocess.TimeoutExpired, OSError):
            continue
    raise RuntimeError("No clipboard tool worked (install wl-clipboard for Wayland, xclip for X11, or use Windows).")


def erase_clipboard():
    """Erase clipboard contents by copying empty/whitespace."""
    for cmd in [["powershell", "-Command", "$input | Set-Clipboard"], ["wl-copy"], ["xclip", "-selection", "clipboard"], ["pbcopy"]]:
        try:
            if cmd[0] == "powershell":
                if IS_WINDOWS:
                    subprocess.run(cmd, input=b" " * 20, capture_output=True, timeout=5)
                    return
                continue
            if _which(cmd[0]):
                subprocess.run(cmd, input=b" " * 20, capture_output=True, timeout=5)
                return
        except (subprocess.TimeoutExpired, OSError):
            continue


def secure_copy_clipboard(text, timeout=30):
    """Copy code to clipboard and schedule auto-erase after `timeout` seconds."""
    backend = copy_clipboard(text)
    if timeout > 0:
        def _erase():
            time.sleep(timeout)
            erase_clipboard()
        t = threading.Thread(target=_erase, daemon=True)
        t.start()
    return backend


def get_plain(msg):
    """Extract plain text from email, with proper HTML-to-text conversion."""
    if msg.is_multipart():
        plain = html = None
        for part in msg.walk():
            ct = part.get_content_type()
            if ct == "text/plain" and plain is None:
                try:
                    payload = part.get_payload(decode=True)
                    if payload:
                        plain = payload.decode("utf-8", "replace")
                except Exception:
                    pass
            elif ct == "text/html" and html is None:
                try:
                    payload = part.get_payload(decode=True)
                    if payload:
                        html = payload.decode("utf-8", "replace")
                except Exception:
                    pass
        if plain:
            return plain
        if html:
            return html_to_text(html)
        return ""
    try:
        body = msg.get_payload(decode=True)
        if body is None:
            return ""
        return body.decode("utf-8", "replace")
    except Exception:
        return str(msg)


def html_to_text(html):
    """Convert HTML email body to clean text for parsing."""
    text = html
    # Remove style and script blocks entirely
    text = re.sub(r"<style[^>]*>.*?</style>", " ", text, flags=re.S | re.I)
    text = re.sub(r"<script[^>]*>.*?</script>", " ", text, flags=re.S | re.I)
    # Remove comments
    text = re.sub(r"<!--.*?-->", " ", text, flags=re.S)
    # Replace common block elements with newlines
    text = re.sub(r"</?(?:div|p|br|tr|li|h[1-6]|blockquote|section|article|header|footer)[^>]*>",
                  "\n", text, flags=re.I)
    # Replace remaining tags with spaces
    text = re.sub(r"<[^>]+>", " ", text)
    # Decode entities
    entities = {
        "&nbsp;": " ", "&amp;": "&", "&gt;": ">", "&lt;": "<",
        "&quot;": '"', "&apos;": "'", "&#160;": " ", "&#39;": "'",
        "&#x27;": "'", "&#x2F;": "/",
    }
    for a, b in entities.items():
        text = text.replace(a, b)
    # Collapse whitespace
    text = re.sub(r"\n\s*\n", "\n", text)
    text = re.sub(r" +", " ", text)
    return text.strip()


def _sender_domain(sender: str) -> str:
    m = re.search(r"@([^>\s]+)", sender)
    return m.group(1).lower().lstrip(".") if m else sender.lower()


def _code_hash(code: str) -> str:
    return hashlib.sha256(code.encode()).hexdigest()[:16]


def is_known_sender(sender: str) -> bool:
    domain = _sender_domain(sender)
    if domain in KNOWN_SENDERS:
        return True
    parts = domain.split(".")
    for i in range(len(parts) - 1):
        candidate = ".".join(parts[i:])
        if candidate in KNOWN_SENDERS:
            return True
    return False


