def daemon_run(args):
    """Background daemon mode: watch inbox, auto-copy codes, extract events."""
    creds = load_creds()
    window = datetime.timedelta(minutes=args.minutes)
    state = load_state()
    last_uid = int(state.get("last_uid", 0))
    
    seen_codes = OrderedDict((k, True) for k in state.get("seen_codes", []))
    seen_events = OrderedDict((k, True) for k in state.get("seen_events", []))
    seen_subscriptions = OrderedDict((k, True) for k in state.get("seen_subscriptions", []))
    
    interval = args.interval
    have_calendar = bool(get_calendar_service())

    if args.secure_timeout > 0:
        secure_timeout = args.secure_timeout
    elif args.secure:
        secure_timeout = creds.get("secure_timeout", 30)
    elif creds.get("secure"):
        secure_timeout = creds.get("secure_timeout", 30)
    else:
        secure_timeout = 0

    clipboard_available = IS_WINDOWS or IS_MACOS or _which("wl-copy") or _which("xclip")
    if not clipboard_available:
        notify("verify-code", "Clipboard tool missing — codes will be logged but not copied.")
        print(c("WARNING: Clipboard tool missing; codes will be logged but not copied.", Style.YELLOW), file=sys.stderr)

    print(c(f"  🔐  verify-code daemon v{__version__} started", Style.CYAN, Style.BOLD))
    print(f"     Window: {args.minutes}m  |  Interval: {interval}s"
          f"  |  Known-senders: {'yes' if args.known_senders else 'no'}"
          f"  |  Calendar: {'yes' if have_calendar else 'no'}"
          f"  |  Subs: {'yes' if args.subscriptions else 'no'}"
          f"  |  Secure: {'yes' if secure_timeout > 0 else 'no'}{f' ({secure_timeout}s)' if secure_timeout > 0 else ''}")
    if have_calendar:
        print(f"     Calendar min confidence: {args.cal_threshold}%")
    print(f"     Last UID: {last_uid}", flush=True)

    if FORM_FILLER_AVAILABLE and os.path.exists(FORM_DATA_FILE):
        try:
            keyboard.add_hotkey('ctrl+shift+f', trigger_form_fill)
            print(c("  ⌨️  Form filler hotkey registered: Ctrl+Shift+F", Style.GREEN))
        except Exception as e:
            print(c(f"  ⚠  Failed to register form filler hotkey: {e}", Style.YELLOW))
            if not IS_WINDOWS and os.geteuid() != 0:
                print(c("     (Linux requires root/sudo for global hotkeys)", Style.DIM))
    elif FORM_FILLER_AVAILABLE:
        print(c("  ℹ️  Form filler ready but no data saved. Run setup to configure.", Style.DIM))

    while True:
        try:
            con = connect(creds)
            use_idle = args.idle and supports_idle(con)
            if use_idle:
                print(c(f"  [{datetime.datetime.now():%H:%M:%S}] IMAP IDLE supported, but using polling for stability.", Style.DIM), flush=True)
            else:
                print(f"  [{datetime.datetime.now():%H:%M:%S}] {c('Polling', Style.DIM)} mode ({interval}s).", flush=True)

            while True:
                res = find_newest_code(con, window, since_uid=last_uid,
                                       known_senders_only=args.known_senders)
                if not res:
                    if not use_idle:
                        con.noop()
                        time.sleep(interval)
                    else:
                        time.sleep(interval)
                    continue

                now_ts = datetime.datetime.now().strftime("%H:%M:%S")
                last_uid = max(last_uid, int(res.get("max_uid_seen", res["uid"])))

                if not res.get("code") and not res.get("link") and not res.get("events") and not (args.subscriptions and res.get("body")):
                    save_state({
                        "last_uid": last_uid,
                        "seen_codes": list(seen_codes.keys()),
                        "seen_events": list(seen_events.keys()),
                        "seen_subscriptions": list(seen_subscriptions.keys()),
                        "last_time": datetime.datetime.now().isoformat(),
                    })
                    if not use_idle:
                        con.noop()
                        time.sleep(interval)
                    else:
                        time.sleep(interval)
                    continue

                if res["code"]:
                    dedup_key = f"{_sender_domain(res['sender'])}:{_code_hash(res['code'])}"
                    if dedup_key in seen_codes:
                        print(f"  [{now_ts}] skipped duplicate {res['code']} from {res['sender']}", flush=True)
                    else:
                        try:
                            if secure_timeout > 0:
                                secure_copy_clipboard(res["code"], timeout=secure_timeout)
                                notify("Verification code copied ✅", f"{res['code']}  —  {res['subject']}\nFrom: {res['sender']}\nAuto-erase in {secure_timeout}s")
                            else:
                                copy_clipboard(res["code"])
                                notify("Verification code copied ✅", f"{res['code']}  —  {res['subject']}\nFrom: {res['sender']}")
                            log_event(res["sender"], res["subject"], code=res["code"])
                            secure_label = f" 🔒{secure_timeout}s" if secure_timeout > 0 else ""
                            print(c(f"  [{now_ts}] 📋 Copied {res['code']} from {res['sender']} ({res['confidence']}%){secure_label}", Style.GREEN), flush=True)
                        except RuntimeError as e:
                            print(f"  [{now_ts}] clipboard error: {e}", file=sys.stderr, flush=True)
                            log_event(res["sender"], res["subject"], code=res["code"])

                        seen_codes[dedup_key] = True
                        if len(seen_codes) > 50:
                            seen_codes.popitem(last=False)
                            
                elif res.get("link"):
                    dedup_key = f"{_sender_domain(res['sender'])}:{_code_hash(res['link'])}"
                    if dedup_key in seen_codes:
                        print(f"  [{now_ts}] skipped duplicate link from {res['sender']}", flush=True)
                    else:
                        try:
                            copy_clipboard(res["link"])
                            notify("Magic link copied ✅", f"Verification link from {res['sender']}")
                            log_event(res["sender"], res["subject"], code=f"LINK:{res['link']}")
                            print(c(f"  [{now_ts}] 🔗 Copied magic link from {res['sender']}", Style.GREEN), flush=True)
                        except RuntimeError as e:
                            print(f"  [{now_ts}] clipboard error: {e}", file=sys.stderr, flush=True)
                            log_event(res["sender"], res["subject"], code=f"LINK:{res['link']}")

                        seen_codes[dedup_key] = True
                        if len(seen_codes) > 50:
                            seen_codes.popitem(last=False)

                if res["events"]:
                    cal_service = get_calendar_service() # Check freshness
                    if cal_service:
                        for ev in res["events"]:
                            ev_key = f"{res['uid']}:{ev['start']}"
                            if ev_key in seen_events:
                                continue
                            if ev["confidence"] >= args.cal_threshold:
                                link = add_event_to_calendar(ev)
                                if link:
                                    seen_events[ev_key] = True
                                    log_event(res["sender"], res["subject"], event=ev["title"])
                                    msg = f"📅  {ev['title']} @ {ev['start'][:16]}"
                                    notify("Event added to calendar", msg)
                                    print(c(f"  [{now_ts}] {msg}", Style.CYAN), flush=True)
                                    if len(seen_events) > 50:
                                        seen_events.popitem(last=False)
                    else:
                        print(c("  ⚠  Calendar not authorized or token expired. Run: verify-code auth", Style.YELLOW), flush=True)

                if args.subscriptions and res.get("body"):
                    sub = extract_subscription(res["body"], res["subject"], res["sender"])
                    if sub:
                        dedup_key = _subscription_key(sub)
                        if dedup_key not in seen_subscriptions:
                            seen_subscriptions[dedup_key] = True
                            save_subscription(sub)
                            log_event(res["sender"], res["subject"], event=f"sub:{sub['service']}")
                            msg = f"💳  {sub['service']}"
                            if sub["amount"]:
                                msg += f" {sub['amount']}"
                            if sub["billing_cycle"]:
                                msg += f"/{sub['billing_cycle']}"
                            if sub["next_billing"]:
                                msg += f" → renews {sub['next_billing']}"
                            elif sub["trial_end"]:
                                msg += f" → trial ends {sub['trial_end']}"
                            notify("Subscription detected", msg)
                            print(c(f"  [{now_ts}] {msg}", Style.MAGENTA), flush=True)
                            if len(seen_subscriptions) > 50:
                                seen_subscriptions.popitem(last=False)

                save_state({
                    "last_uid": last_uid,
                    "seen_codes": list(seen_codes.keys()),
                    "seen_events": list(seen_events.keys()),
                    "seen_subscriptions": list(seen_subscriptions.keys()),
                    "last_time": datetime.datetime.now().isoformat(),
                })

                if not use_idle:
                    con.noop()

        except (imaplib.IMAP4.error, ssl.SSLError, socket.error, OSError) as e:
            print(f"  [{datetime.datetime.now():%H:%M:%S}] connection error: {e}; retrying…", file=sys.stderr, flush=True)
            time.sleep(max(interval, 10))
        except KeyboardInterrupt:
            print(c("\n  🏹  Daemon stopped.", Style.YELLOW), flush=True)
            break

def scan_mode(args):
    """Scan inbox for events with dates/times (no code copy)."""
    creds = load_creds()
    window = datetime.timedelta(minutes=args.minutes)
    con = connect(creds)
    print(c(f"  🔍  Scanning inbox for events (last {args.minutes} min)...", Style.CYAN, Style.BOLD))
    print()

    try:
        results = find_newest_code(con, window, since_uid=0,
                                   known_senders_only=args.known_senders, find_all=True)
    finally:
        try:
            con.close()
        except Exception:
            pass
        con.logout()

    if not results:
        print("  No emails found in the scan window.")
        return

    if not isinstance(results, list):
        results = [results]

    found_anything = False

    for res in results:
        if res.get("code"):
            found_anything = True
            print(c(f"  📋  Code found: {res['code']}", Style.GREEN, Style.BOLD))
            print(f"     From: {res['sender']}")
            print(f"     Subject: {res['subject']}")
            print(f"     Confidence: {res['confidence']}% ({res['method']})")
            print()
        elif res.get("link"):
            found_anything = True
            print(c(f"  🔗  Magic link found!", Style.GREEN, Style.BOLD))
            print(f"     From: {res['sender']}")
            print(f"     Subject: {res['subject']}")
            print(c(f"     Link: {res['link']}", Style.CYAN))
            print()

        if res["events"]:
            found_anything = True
            print(c(f"  📅  Events found: {len(res['events'])}", Style.CYAN, Style.BOLD))
            print()
            for i, ev in enumerate(res["events"], 1):
                conf_bar = "█" * (ev["confidence"] // 10) + "░" * (10 - ev["confidence"] // 10)
                print(f"  {i}. {c(ev['title'], Style.BOLD)}")
                print(f"     {c('When:', Style.DIM)} {ev['start'][:16]} → {ev['end'][:16]}")
                if ev.get("location"):
                    print(f"     {c('Where:', Style.DIM)} {ev['location']}")
                print(f"     {c('Type:', Style.DIM)} {ev['event_type']}  |  {c('Confidence:', Style.DIM)} {conf_bar} {ev['confidence']}%")
                print()

        if args.subscriptions and res.get("body"):
            sub = extract_subscription(res["body"], res["subject"], res["sender"])
            if sub:
                found_anything = True
                print(c("  💳  Subscription detected:", Style.MAGENTA, Style.BOLD))
                print()
                print(f"     {format_subscription(sub)}")
                print()
                save_subscription(sub)
                print(c("  ✅  Subscription saved to tracker.", Style.GREEN))
                print(c("  Run: verify-code subscriptions  (to view all tracked)", Style.DIM))
                print()

    if not found_anything:
        print("  No events with dates/times found.")
        print("  Tip: Try --minutes 60 to scan a wider window.")
        print()

