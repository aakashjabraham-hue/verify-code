def run(args):
    """One-shot mode: find and copy the newest code."""
    creds = load_creds()
    window = datetime.timedelta(minutes=args.minutes)
    con = connect(creds)
    try:
        res = find_newest_code(con, window, since_uid=0,
                               known_senders_only=args.known_senders)
    finally:
        try:
            con.close()
        except Exception:
            pass
        con.logout()

    if not res or not res.get("code"):
        print(f"No verification code found in the last {args.minutes} minutes.")
        if args.known_senders:
            print("Tip: remove --known-senders to check all senders (higher FP risk).")
        else:
            print("Tip: run right after the email arrives, or bump --minutes.")
        return

    if args.dry_run:
        print(f"[dry-run] Would copy code from: {res['sender']}")
        print(f"  Subject:    {res['subject']!r}")
        if res["code"]:
            print(f"  Code:       {res['code']}  (confidence: {res['confidence']}%, method: {res['method']})")
        else:
            print("  Code:       (none found)")
        if res["events"]:
            for ev in res["events"]:
                print(f"  Event:      {ev['title']} @ {ev['start']}  (confidence: {ev['confidence']}%)")
        print(f"  Age:        {res['age']}")
        return

    if res["code"]:
        secure_timeout = 0
        try:
            creds_data = load_creds()
            if creds_data.get("secure"):
                secure_timeout = creds_data.get("secure_timeout", 30)
        except Exception:
            pass

        if secure_timeout > 0:
            backend = secure_copy_clipboard(res["code"], timeout=secure_timeout)
            notify("verify-code", f"Copied code: {res['code']} (auto-erase in {secure_timeout}s)")
            print(c(f"  📋  Copied verification code to clipboard ({backend}).", Style.GREEN, Style.BOLD))
            print(c(f"  🔒  Auto-erase in {secure_timeout}s", Style.YELLOW))
        else:
            backend = copy_clipboard(res["code"])
            notify("verify-code", f"Copied code: {res['code']} from {res['sender']}")
            print(c(f"  📋  Copied verification code to clipboard ({backend}).", Style.GREEN, Style.BOLD))
        log_event(res["sender"], res["subject"], code=res["code"])
        print(f"  From:    {res['sender']}")
        print(f"  Subject: {res['subject']}")
        print(c(f"  Code:    {res['code']}", Style.CYAN, Style.BOLD))
        print(f"  Confidence: {res['confidence']}%  ({res['method']})")
        print()
    else:
        print(c("  📭  Email found, but no verification code could be extracted.", Style.YELLOW))
        print(f"  From:    {res['sender']}")
        print(f"  Subject: {res['subject']}")
        if res.get("events"):
            print(f"  📅  {len(res['events'])} event(s) found in this email.")
        print()

    if res["events"] and args.calendar and not args.dry_run:
        calendar_service = get_calendar_service()
        if calendar_service:
            for ev in res["events"]:
                if ev["confidence"] >= args.cal_threshold:
                    link = add_event_to_calendar(ev)
                    if link:
                        log_event(res["sender"], res["subject"], event=ev["title"])
                        print(c(f"  📅  Added to calendar: {ev['title']}", Style.GREEN))
                        print(f"  When: {ev['start']} → {ev['end']}")
                        if ev.get("location"):
                            print(f"  Where: {ev['location']}")
        else:
            if res["events"]:
                print(c("  ⚠  Calendar not authorized. Run: verify-code auth", Style.YELLOW))

    if args.subscriptions and res.get("body") and not args.dry_run:
        sub = extract_subscription(res["body"], res["subject"], res["sender"])
        if sub:
            dedup_key = _subscription_key(sub)
            state = load_state()
            seen_subs = set(state.get("seen_subscriptions", []))
            if dedup_key not in seen_subs:
                seen_subs.add(dedup_key)
                save_subscription(sub)
                log_event(res["sender"], res["subject"], event=f"sub:{sub['service']}")
                save_state({
                    "last_uid": state.get("last_uid", 0),
                    "seen_codes": state.get("seen_codes", []),
                    "seen_events": state.get("seen_events", []),
                    "seen_subscriptions": list(seen_subs),
                    "last_time": datetime.datetime.now().isoformat(),
                })
                print(c(f"  💳  Subscription detected: {sub['service']}", Style.MAGENTA, Style.BOLD))
                if sub["amount"]:
                    print(f"      {sub['amount']}", end="")
                    if sub["billing_cycle"]:
                        print(f"/{sub['billing_cycle']}", end="")
                    print()
                if sub["next_billing"]:
                    print(f"      Next renewal: {sub['next_billing']}")
                if sub["trial_end"]:
                    print(c(f"      ⚠ Trial ends: {sub['trial_end']}", Style.YELLOW))
                print()


def history_cmd():
    print()
    print(c("  ╔══════════════════════════════════════════╗", Style.CYAN, Style.BOLD))
    print(c("  ║   📋  verify-code history                ║", Style.CYAN, Style.BOLD))
    print(c("  ╚══════════════════════════════════════════╝", Style.CYAN, Style.BOLD))
    print()

    if not os.path.exists(LOG_FILE):
        print(c("  No codes copied yet.", Style.DIM))
        print()
        return

    try:
        with open(LOG_FILE) as f:
            lines = f.readlines()
    except Exception as e:
        print(c(f"  ✗  Could not read history: {e}", Style.RED))
        return

    code_entries = [l.strip() for l in lines if " CODE " in l]
    if not code_entries:
        print(c("  No codes have been copied yet.", Style.DIM))
        print()
        return

    for entry in code_entries[-10:]:
        m = re.match(r"\[(.*?)\] CODE sender=(.*?) subject=(.*?) code=(.*)", entry)
        if m:
            ts, sender, subject, code = m.groups()
            print(f"  {c(ts, Style.DIM)}  {c(code, Style.GREEN, Style.BOLD)}  "
                  f"from {c(sender[:30], Style.DIM)}")
        else:
            print(f"  {entry}")

    print()
    print(c(f"  Showing {min(len(code_entries), 10)} of {len(code_entries)} total entries.", Style.DIM))
    print()
    print("  Full log: ~/.local/share/verify-code/log.txt (Linux/macOS)")
    print("  or:       %APPDATA%\\verify-code\\data\\log.txt (Windows)")
    print()


def subscriptions_cmd(args):
    subs = load_subscriptions()

    print()
    print(c("  ╔══════════════════════════════════════════╗", Style.CYAN, Style.BOLD))
    print(c("  ║   💳  Subscription Tracker              ║", Style.CYAN, Style.BOLD))
    print(c("  ╚══════════════════════════════════════════╝", Style.CYAN, Style.BOLD))
    print()

    if not subs:
        print(c("  No subscriptions tracked yet.", Style.DIM))
        print()
        print("  Run the daemon to auto-detect subscriptions from your inbox.")
        print("  Or run: verify-code scan --subscriptions")
        print()
        return

    warn_days = args.warn_days if args.warn_days else 3
    warnings = check_subscription_warnings(subs, warn_days=warn_days)

    if warnings:
        print(c(f"  ⚠  Upcoming Changes ({warn_days}-day window)", Style.YELLOW, Style.BOLD))
        print()
        for w in warnings:
            if w["warn_type"] == "trial_end":
                label = c(f"  ⚠  Trial ends in {w['days_until']}d", Style.YELLOW, Style.BOLD)
                print(f"  {label}  {format_subscription(w, warn=True)}")
            elif w["warn_type"] == "renewal":
                if w["days_until"] == 0:
                    label = c(f"  🔄  Renewing TODAY", Style.YELLOW, Style.BOLD)
                else:
                    label = c(f"  🔄  Renews in {w['days_until']}d", Style.YELLOW, Style.BOLD)
                print(f"  {label}  {format_subscription(w, warn=True)}")
        print()

    def sort_key(s):
        status_rank = 0 if s.get("status") == "cancelled" else 1
        billing = s.get("next_billing") or s.get("trial_end") or "9999-99-99"
        return (status_rank, billing)

    subs_sorted = sorted(subs, key=sort_key)

    active = [s for s in subs_sorted if s.get("status") != "cancelled"]
    total_monthly = 0
    total_yearly = 0
    for s in active:
        amt = s.get("amount", "")
        if amt:
            try:
                val = float(amt.replace("$", "").replace(",", ""))
                cycle = s.get("billing_cycle")
                if cycle == "yearly":
                    total_yearly += val
                elif cycle == "monthly":
                    total_monthly += val
                elif cycle == "weekly":
                    total_monthly += val * 4.33
                elif cycle == "quarterly":
                    total_monthly += val / 3
                else:
                    total_monthly += val
            except (ValueError, TypeError):
                pass

    print(c(f"  📊  {len(active)} active subscriptions", Style.BOLD))
    if total_monthly > 0:
        print(f"     ~${total_monthly:.2f}/month", end="")
        if total_yearly > 0:
            print(f"  ($" + f"{total_yearly:.2f}/year)", end="")
        print(f"  |  {len(subs_sorted) - len(active)} cancelled")
    elif total_yearly > 0:
        print(f"     ~${total_yearly:.2f}/year  |  {len(subs_sorted) - len(active)} cancelled")
    else:
        print(f"     {len(subs_sorted) - len(active)} cancelled")
    print()

    print(c("  ────────────────────────────────────────────────────────", Style.DIM))
    print(c("  Service           Plan        Amount   Cycle     Next Billing", Style.BOLD))
    print(c("  ────────────────────────────────────────────────────────", Style.DIM))

    for sub in subs_sorted:
        service = sub["service"][:18].ljust(18)
        plan = (sub.get("plan") or "")[:12].ljust(12)
        amount = (sub.get("amount") or "").rjust(8)
        cycle = (sub.get("billing_cycle") or "").ljust(9)
        if sub.get("next_billing"):
            next_bill = sub["next_billing"]
        elif sub.get("trial_end"):
            next_bill = c(f"trial:{sub['trial_end']}", Style.YELLOW)
        else:
            next_bill = "—"

        status_mark = ""
        if sub.get("status") == "cancelled":
            status_mark = c(" ❌", Style.RED)
        elif sub.get("status") == "trial":
            status_mark = c(" ⚡", Style.YELLOW)
        else:
            if sub.get("next_billing"):
                try:
                    renew_date = datetime.datetime.strptime(sub["next_billing"], "%Y-%m-%d").date()
                    days_until = (renew_date - datetime.datetime.now().date()).days
                    if 0 <= days_until <= warn_days:
                        status_mark = c(" ⚠", Style.YELLOW)
                except ValueError:
                    pass

        print(f"  {service}{plan}{amount} {cycle}{next_bill}{status_mark}")

    print(c("  ────────────────────────────────────────────────────────", Style.DIM))
    print()
    print(c("  Tip:", Style.DIM), "subscriptions are auto-detected from inbox emails.")
    print(c("  Run:", Style.DIM), "verify-code daemon --subscriptions  (to track in background)")
    print()


