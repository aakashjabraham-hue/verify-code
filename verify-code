def copy_clipboard(text):
    text = text.strip().replace(" ", "").replace("-", "")
    for cmd, backend in [
        (["powershell", "-Command", "$input | Set-Clipboard"], "windows"),
        (["wl-copy"], "wayland"),
        (["xclip", "-selection", "clipboard"], "x11"),
        (["pbcopy"], "macos"),
    ]:
        try:
            if cmd[0] == "powershell":
                if IS_WINDOWS:
                    res = subprocess.run(cmd, input=text.encode(), capture_output=True, timeout=5)
                    if res.returncode == 0:
                        return backend
                    continue
                else:
                    continue
            if _which(cmd[0]):
                # FIX: Use DEVNULL instead of capture_output=True.
                # wl-copy and xclip fork a background process to keep the clipboard alive.
                # If we capture output, Python waits for the pipe to close, which blocks 
                # forever and causes a TimeoutExpired exception.
                res = subprocess.run(
                    cmd, 
                    input=text.encode(), 
                    stdout=subprocess.DEVNULL, 
                    stderr=subprocess.DEVNULL, 
                    timeout=5
                )
                if res.returncode == 0:
                    return backend
                continue
        except (subprocess.TimeoutExpired, OSError):
            continue
    raise RuntimeError("No clipboard tool worked (install wl-clipboard for Wayland, xclip for X11, or use Windows).")


def erase_clipboard():
    for cmd in [["powershell", "-Command", "$input | Set-Clipboard"], ["wl-copy"], ["xclip", "-selection", "clipboard"], ["pbcopy"]]:
        try:
            if cmd[0] == "powershell":
                if IS_WINDOWS:
                    subprocess.run(cmd, input=b" " * 20, capture_output=True, timeout=5)
                    return
                continue
            if _which(cmd[0]):
                # FIX: Redirect to DEVNULL so Python doesn't block waiting for the background process
                subprocess.run(cmd, input=b" " * 20, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
                return
        except (subprocess.TimeoutExpired, OSError):
            continue

def secure_copy_clipboard(text, timeout=30):
    """Copy code to clipboard and schedule auto-erase after `timeout` seconds."""
    global _CLIPBOARD_GEN
    backend = copy_clipboard(text)
    if timeout > 0:
        _CLIPBOARD_GEN += 1
        my_gen = _CLIPBOARD_GEN
        
        def _erase():
            time.sleep(timeout)
            # Only erase if no newer code has been copied!
            if my_gen == _CLIPBOARD_GEN:
                erase_clipboard()
                
        t = threading.Thread(target=_erase, daemon=True)
        t.start()
    return backend


def get_plain(msg):
    """Extract plain text from email, with proper charset handling."""
    if msg.is_multipart():
        plain = html = None
        for part in msg.walk():
            ct = part.get_content_type()
            if ct == "text/plain" and plain is None:
                try:
                    payload = part.get_payload(decode=True)
                    if payload:
                        charset = part.get_content_charset() or "utf-8"
                        try:
                            plain = payload.decode(charset, errors="replace")
                        except LookupError:
                            plain = payload.decode("utf-8", errors="replace")
                except Exception:
                    pass
            elif ct == "text/html" and html is None:
                try:
                    payload = part.get_payload(decode=True)
                    if payload:
                        charset = part.get_content_charset() or "utf-8"
                        try:
                            html = payload.decode(charset, errors="replace")
                        except LookupError:
                            html = payload.decode("utf-8", errors="replace")
                except Exception:
                    pass
        if plain:
            return plain
        if html:
            return html_to_text(html)
        return ""
    try:
        body = msg.get_payload(decode=True)
        if body is None:
            return ""
        charset = msg.get_content_charset() or "utf-8"
        try:
            return body.decode(charset, errors="replace")
        except LookupError:
            return body.decode("utf-8", errors="replace")
    except Exception:
        return str(msg)


def html_to_text(html):
    text = html
    text = re.sub(r"<style[^>]*>.*?</style>", " ", text, flags=re.S | re.I)
    text = re.sub(r"<script[^>]*>.*?</script>", " ", text, flags=re.S | re.I)
    text = re.sub(r"<!--.*?-->", " ", text, flags=re.S)
    text = re.sub(r"</?(?:div|p|br|tr|li|h[1-6]|blockquote|section|article|header|footer)[^>]*>",
                  "\n", text, flags=re.I)
    text = re.sub(r"<[^>]+>", " ", text)
    entities = {
        "&nbsp;": " ", "&amp;": "&", "&gt;": ">", "&lt;": "<",
        "&quot;": '"', "&apos;": "'", "&#160;": " ", "&#39;": "'",
        "&#x27;": "'", "&#x2F;": "/",
    }
    for a, b in entities.items():
        text = text.replace(a, b)
    text = re.sub(r"\n\s*\n", "\n", text)
    text = re.sub(r" +", " ", text)
    return text.strip()


def _sender_domain(sender: str) -> str:
    m = re.search(r"@([^>\s]+)", sender)
    return m.group(1).lower().lstrip(".") if m else sender.lower()


def _code_hash(code: str) -> str:
    return hashlib.sha256(code.encode()).hexdigest()[:16]


def is_known_sender(sender: str) -> bool:
    domain = _sender_domain(sender)
    if domain in KNOWN_SENDERS:
        return True
    parts = domain.split(".")
    for i in range(len(parts) - 1):
        candidate = ".".join(parts[i:])
        if candidate in KNOWN_SENDERS:
            return True
    return False


# ═══════════════════════════════════════════════════════════════════════
# Code Extraction
# ═══════════════════════════════════════════════════════════════════════

def extract_code(text, subject="", sender=""):
    combined = f"{subject} {sender} {text[:2000]}"
    has_context = bool(CONTEXT_WORDS.search(combined))
    known_sender = is_known_sender(sender)

    m = RE_EXPLICIT.search(text)
    if m:
        raw = m.group(1)
        cleaned = raw.replace(" ", "").replace("-", "")
        if len(cleaned) >= 4:
            return {"code": cleaned, "confidence": 95, "method": "explicit_label"}

    if has_context or known_sender:
        m = RE_GROUPED.search(text)
        if m:
            cleaned = m.group(1).replace(" ", "").replace("-", "")
            return {"code": cleaned, "confidence": 88, "method": "grouped_3_3"}

    if known_sender and has_context:
        for m in RE_ALPHANUM.finditer(text):
            code = m.group(1)
            if len(code) >= 4 and len(code) <= 12:
                return {"code": code, "confidence": 80, "method": "alphanumeric"}

    m = RE_PLAIN_STRICT.search(text)
    if m:
        score = 65 if known_sender else 45
        if has_context:
            score += 15
        return {"code": m.group(1), "confidence": score, "method": "bare_digits"}

    if known_sender and has_context:
        m = RE_PLAIN_4.search(text)
        if m:
            code = m.group(1)
            idx = text.find(code)
            nearby = text[max(0, idx - 80):idx + len(code) + 80]
            if CONTEXT_WORDS.search(nearby):
                return {"code": code, "confidence": 55, "method": "short_4_digit"}

    return None


# ═══════════════════════════════════════════════════════════════════════
# Date/Time + Event Extraction
# ═══════════════════════════════════════════════════════════════════════

def extract_datetime(text, subject="", sender=""):
    events = []
    body = text[:5000]
    combined = f"{subject} {sender} {body}"

    if not DATEUTIL_AVAILABLE:
        return events

    event_type = "event"
    body_lower = body.lower() + " " + subject.lower()
    type_scores = {}
    for etype, keywords in EVENT_KEYWORDS.items():
        score = sum(1 for kw in keywords if kw in body_lower)
        if score > 0:
            type_scores[etype] = score
    if type_scores:
        event_type = max(type_scores, key=type_scores.get)

    title = subject.strip()
    title_clean = re.sub(
        r"^(?:Re:|Fwd?|Confirmed|Reminder|Your|Upcoming|Scheduled|New)",
        "", title, flags=re.I
    ).strip(" :,;-\"'")
    if not title_clean:
        title_clean = event_type.capitalize()

    location = None
    loc_patterns = [
        re.compile(r"(?:at|in|location|venue|address)[:\s]+([A-Za-z0-9\s,.'\-]+?)(?:\.|$|\n)", re.I),
        re.compile(r"(?:located at|meet at|arrive at)[:\s]+([A-Za-z0-9\s,.'\-]+?)(?:\.|$|\n)", re.I),
    ]
    for pat in loc_patterns:
        m = pat.search(body)
        if m:
            loc = m.group(1).strip()
            if len(loc) > 3 and len(loc) < 100:
                location = loc
                break

    now = datetime.datetime.now()
    found_dates = []

    for m in RE_DATE_FULL.finditer(body):
        date_str = m.group(1)
        time_str = m.group(2) if m.lastindex >= 2 and m.group(2) else None
        full_str = date_str
        if time_str:
            full_str += " " + time_str
        full_str = full_str.rstrip(".,;:!?")
        try:
            dt = dateparser.parse(full_str, fuzzy=True, default=now)
            if dt and dt > datetime.datetime(2000, 1, 1):
                found_dates.append((dt, 85))
        except (ValueError, TypeError):
            pass

    seen_dates = set()
    for m in RE_DATE_MONTH_DAY.finditer(body):
        date_str = m.group(1)
        time_str = m.group(2) if m.lastindex >= 2 and m.group(2) else None
        full_str = date_str
        if time_str:
            full_str += " " + time_str
        full_str = full_str.rstrip(".,;:!?")
        try:
            dt = dateparser.parse(full_str, fuzzy=True, default=now)
            if dt and dt > datetime.datetime(2000, 1, 1):
                key = dt.strftime("%Y%m%d%H%M")
                if key not in seen_dates:
                    found_dates.append((dt, 80))
                    seen_dates.add(key)
        except (ValueError, TypeError):
            pass

    for m in RE_DATE_ISO.finditer(body):
        try:
            dt = dateparser.parse(m.group(1), fuzzy=False)
            if dt:
                nearby = body[m.end():m.end() + 60]
                time_m = RE_TIME.search(nearby)
                if time_m:
                    try:
                        full = f"{m.group(1)} {time_m.group(1)}"
                        dt = dateparser.parse(full, fuzzy=False)
                    except (ValueError, TypeError):
                        pass
                found_dates.append((dt, 70))
        except (ValueError, TypeError):
            pass

    for m in RE_DATE_US.finditer(body):
        parts = m.group(1).replace("-", "/").split("/")
        if len(parts) == 3:
            try:
                parts = [int(p) for p in parts]
                if parts[0] <= 12 and parts[0] >= 1 and parts[1] <= 31 and parts[2] >= 2020:
                    nearby = body[m.end():m.end() + 60]
                    time_m = RE_TIME.search(nearby)
                    dt = datetime.datetime(parts[2], parts[0], parts[1])
                    if time_m:
                        try:
                            full = f"{m.group(1)} {time_m.group(1)}"
                            dt = dateparser.parse(full, fuzzy=False)
                        except (ValueError, TypeError):
                            dt = dt.replace(hour=12)
                    else:
                        dt = dt.replace(hour=12)
                    found_dates.append((dt, 60))
            except (ValueError, TypeError):
                pass

    # Removed Method 4 (Fuzzy dateutil parsing) to prevent massive CPU usage and false positives.

    seen = set()
    unique_dates = []
    for dt, conf in found_dates:
        key = dt.strftime("%Y%m%d%H%M")
        if key not in seen:
            seen.add(key)
            unique_dates.append((dt, conf))

    unique_dates.sort(key=lambda x: -x[1])

    for dt, conf in unique_dates:
        if dt < now - datetime.timedelta(days=1):
            continue

        end_dt = None
        time_text = body[max(0, body.lower().find(dt.strftime("%B")) - 20):
                         body.lower().find(dt.strftime("%B")) + 120]
        range_m = re.search(
            r"(?:to|-|–|until)\s*(\d{1,2}(?::\d{2})?\s*(?:[ap]\.?\s*m\.?|AM|PM|am|pm)?)",
            time_text, re.I
        )
        if range_m:
            try:
                end_str = dt.strftime("%Y-%m-%d") + " " + range_m.group(1)
                end_dt = dateparser.parse(end_str, fuzzy=False)
            except (ValueError, TypeError):
                pass

        if end_dt is None:
            end_dt = dt + datetime.timedelta(hours=1)

        event = {
            "title": title_clean[:80],
            "start": dt.isoformat(),
            "end": end_dt.isoformat(),
            "location": location,
            "confidence": conf,
            "event_type": event_type,
            "source": "email",
        }
        events.append(event)

    return events


